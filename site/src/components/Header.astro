---
import Logo from "./Logo.astro";
import InstallButton from "./InstallButton.astro";
import { NAV } from "../lib/site";
/** The first items of the Features menu are the area pages; the rest are single features. */
const AREA_COUNT = 6;
const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="CRO Toolbox home"><Logo /></a>
    <nav aria-label="Main" class="desktop">
      {
        NAV.map((l) =>
          l.children ? (
            <div class="menu" data-menu>
              <button type="button" class="trigger" aria-expanded="false" aria-controls="menu-features" aria-haspopup="true">
                {l.label}
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <ul class="panel" id="menu-features">
                {l.children.map((c) => (
                  <li class={c.label === "All features" ? "all" : undefined}>
                    <a href={c.href} aria-current={c.href === here ? "page" : undefined}>{c.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a href={l.href} aria-current={l.href === here ? "page" : undefined}>{l.label}</a>
          )
        )
      }
    </nav>
    <div class="cta"><InstallButton medium="header" campaign={here === "/" ? "home" : here.replace(/^\/|\/$/g, "").replace(/\//g, "_")} class="primary small" /></div>
    <details class="mobile">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <div class="sheet">
        <nav aria-label="Main mobile">
          {
            NAV.map((l) =>
              l.children ? (
                <details class="group">
                  <summary>
                    {l.label}
                    <svg width="12" height="12" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </summary>
                  <p class="group-title">By area</p>
                  {l.children.slice(0, AREA_COUNT).map((c) => <a href={c.href} class="sub">{c.label}</a>)}
                  <p class="group-title">Popular features</p>
                  {l.children.slice(AREA_COUNT).map((c) => <a href={c.href} class="sub">{c.label}</a>)}
                </details>
              ) : (
                <a href={l.href} class="top" aria-current={l.href === here ? "page" : undefined}>{l.label}</a>
              )
            )
          }
          <a href="/help/" class="top" aria-current={here === "/help/" ? "page" : undefined}>Help</a>
        </nav>
        <div class="sheet-cta"><InstallButton medium="header" campaign="mobile_menu" class="primary" /></div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgb(11 11 15 / 0.06);
  }
  /* The frosted background sits on its own layer: a blur on the header itself would make it the box the
     fixed phone menu is measured from (Safari), so the menu would shrink to the header's 68 px. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .home {
    text-decoration: none;
  }
  .desktop {
    display: none;
    gap: 4px;
    margin-left: 16px;
  }
  .desktop a {
    padding: 8px 14px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 550;
    color: #34363f;
    white-space: nowrap;
  }
  .menu {
    position: relative;
  }
  .trigger {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 550;
    color: #34363f;
    cursor: pointer;
  }
  .trigger svg {
    transition: transform 0.15s;
  }
  .trigger:hover,
  .trigger[aria-expanded="true"] {
    color: var(--ink);
  }
  .trigger[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  /* The panel floats over the page (position absolute) and is hidden with visibility, so opening it never moves anything. */
  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    min-width: 230px;
    margin: 6px 0 0;
    padding: 8px 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgb(11 11 15 / 0.08);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.12s, transform 0.12s, visibility 0s linear 0.12s;
  }
  .panel::before {
    /* Bridges the gap so the pointer can travel from the button to the panel. */
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -8px;
    height: 8px;
  }
  .menu.open .panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .panel li:nth-child(5),
  .panel li:nth-child(13) {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--mist-2);
  }
  .panel a {
    display: block;
    padding: 8px 18px;
  }
  /* Plain hover: darker text and an underline, no rounded highlight. */
  .desktop > a:hover,
  .desktop > a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
  }
  .panel a:hover,
  .panel a[aria-current="page"] {
    color: var(--ink);
    background: var(--mist);
  }
  .cta {
    margin-left: auto;
    display: none;
  }
  .mobile {
    margin-left: auto;
  }
  .mobile > summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-content: center;
    gap: 5px;
  }
  .mobile summary::-webkit-details-marker {
    display: none;
  }
  .mobile > summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .mobile[open] > summary span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile[open] > summary span:nth-child(2) {
    opacity: 0;
  }
  .mobile[open] > summary span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  /* Full height sheet under the header: scrolls on its own, the button stays at the bottom. */
  .sheet {
    position: fixed;
    left: 0;
    right: 0;
    top: 68px;
    bottom: 0;
    height: calc(100dvh - 68px);
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .sheet nav {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px var(--gutter) 24px;
    display: grid;
    align-content: start;
  }
  .sheet a.top,
  .sheet .group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--mist-2);
    cursor: pointer;
    list-style: none;
  }
  .sheet .group[open] > summary svg {
    transform: rotate(180deg);
  }
  .sheet .group > summary svg {
    transition: transform 0.15s;
  }
  .sheet .group[open] {
    border-bottom: 1px solid var(--mist-2);
    padding-bottom: 8px;
  }
  .sheet .group[open] > summary {
    border-bottom: 0;
  }
  .sheet .group-title {
    margin: 12px 0 4px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sheet a.sub {
    display: block;
    padding: 9px 0 9px 2px;
    font-size: 1rem;
    font-weight: 500;
    color: #34363f;
    text-decoration: none;
  }
  .sheet-cta {
    padding: 12px var(--gutter) calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--mist-2);
    background: #fff;
  }
  .sheet-cta :global(.btn) {
    width: 100%;
    justify-content: center;
  }
  /* The full menu needs about 1050 px on one line (logo, 5 links, install button); below that the phone menu shows. */
  @media (min-width: 1120px) {
    .desktop,
    .cta {
      display: flex;
    }
    .mobile {
      display: none;
    }
  }
</style>

<script>
  // Phone menu: the page behind it doesn't scroll while it is open; Escape or a link closes it.
  const mobile = document.querySelector<HTMLDetailsElement>("details.mobile");
  if (mobile) {
    // iPhones ignore overflow on <html> alone, so the body is locked too.
    mobile.addEventListener("toggle", () => {
      document.documentElement.style.overflow = mobile.open ? "hidden" : "";
      document.body.style.overflow = mobile.open ? "hidden" : "";
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobile.open) {
        mobile.open = false;
        mobile.querySelector("summary")?.focus();
      }
    });
    mobile.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (mobile.open = false)));
  }

  // Features dropdown: opens on hover (mouse), on click or tap, and with Enter or Space on the
  // button. Escape or a click elsewhere closes it, and Tab out of it closes it too.
  document.querySelectorAll<HTMLElement>("[data-menu]").forEach((menu) => {
    const button = menu.querySelector<HTMLButtonElement>(".trigger")!;
    const set = (open: boolean) => {
      menu.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
    };
    // Hover opens it on a mouse (the script sets the state, so the arrow and aria-expanded follow).
    // A click right after hover opened it keeps it open instead of closing it again.
    let hoverOpenedAt = 0;
    let leaveTimer: number | undefined;
    if (window.matchMedia("(hover: hover)").matches) {
      menu.addEventListener("mouseenter", () => {
        clearTimeout(leaveTimer);
        if (button.getAttribute("aria-expanded") !== "true") {
          hoverOpenedAt = Date.now();
          set(true);
        }
      });
      menu.addEventListener("mouseleave", () => {
        leaveTimer = window.setTimeout(() => set(false), 150);
      });
    }
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      if (open && Date.now() - hoverOpenedAt < 600) return;
      set(!open);
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        set(false);
        button.focus();
      }
      if (e.key === "ArrowDown" && document.activeElement === button) {
        e.preventDefault();
        set(true);
        menu.querySelector<HTMLAnchorElement>(".panel a")?.focus();
      }
    });
    menu.addEventListener("focusout", (e) => {
      if (!menu.contains((e as FocusEvent).relatedTarget as Node | null)) set(false);
    });
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node)) set(false);
    });
  });
</script>
