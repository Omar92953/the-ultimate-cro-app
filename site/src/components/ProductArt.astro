---
/** A demo product picture: the real file site/public/products/<kind>.* when there is one, else the drawn SVG (lib/art.ts). */
import { artSvg, productImage, type ArtKind } from "../lib/art";
interface Props {
  kind: ArtKind;
  class?: string;
  /** Alt text. Empty for decorative uses. */
  alt?: string;
  /** "slice" fills the box (may crop), "meet" shows the whole product with the background extended. */
  fit?: "slice" | "meet";
  tint?: string;
}
const { kind, class: cls, alt = "", fit = "slice", tint } = Astro.props;
// Gradient ids must be unique on the page; a module counter keeps builds deterministic.
const g = globalThis as { __artId?: number };
const id = `art${(g.__artId = (g.__artId ?? 0) + 1)}`;
const photo = productImage(kind);
---

{
  photo ? (
    <img class:list={[cls, "product-art"]} src={`/products/${photo.name}.${photo.ext}`} alt={alt} width="800" height="800" loading="lazy" decoding="async" />
  ) : (
    <Fragment set:html={artSvg(kind, { id, alt, fit, tint, cls: [cls, "product-art"].filter(Boolean).join(" ") })} />  )
}
