---
/**
 * Product pictures for the demo store, drawn as SVG (no stock photos needed, sharp at any size,
 * a few hundred bytes each). Each kind has its own soft background.
 */
export type ArtKind = "serum" | "cream" | "candle" | "mug" | "tote" | "soap" | "bottle" | "tee";
interface Props {
  kind: ArtKind;
  class?: string;
  /** Alt text. Empty for decorative uses. */
  alt?: string;
  /** "slice" fills the box (may crop), "meet" shows the whole product with the background extended. */
  fit?: "slice" | "meet";
}
const { kind, class: cls, alt = "", fit = "slice" } = Astro.props;
// Gradient ids must be unique on the page; a module counter keeps builds deterministic.
const g = globalThis as { __artId?: number };
const id = `art${(g.__artId = (g.__artId ?? 0) + 1)}`;
const BG: Record<ArtKind, [string, string]> = {
  serum: ["#f6e7da", "#efd6c2"],
  cream: ["#e6eef2", "#d3e2ea"],
  candle: ["#efe7dc", "#e2d5c3"],
  mug: ["#e5ece4", "#d2dfd0"],
  tote: ["#ece6f3", "#dcd3ea"],
  soap: ["#f4ede0", "#ebdfc8"],
  bottle: ["#e3ecf0", "#cfdfe6"],
  tee: ["#f1e4e4", "#e6d0d0"],
};
const [bg1, bg2] = BG[kind];
---

<svg class={cls} viewBox="0 0 200 200" role={alt ? "img" : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : "true"} preserveAspectRatio={`xMidYMid ${fit}`} style={fit === "meet" ? `background:linear-gradient(${bg1},${bg2})` : undefined}>
  <defs>
    <linearGradient id={`${id}bg`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={bg1}></stop><stop offset="1" stop-color={bg2}></stop></linearGradient>
    <linearGradient id={`${id}sh`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".55"></stop><stop offset=".35" stop-color="#fff" stop-opacity="0"></stop><stop offset="1" stop-color="#000" stop-opacity=".08"></stop></linearGradient>
  </defs>
  <rect width="200" height="200" fill={`url(#${id}bg)`}></rect>
  <ellipse cx="100" cy="168" rx="52" ry="7" fill="#000" opacity=".08"></ellipse>
  {
    kind === "serum" && (
      <g>
        <rect x="82" y="40" width="36" height="22" rx="6" fill="#2b2420" />
        <rect x="88" y="26" width="24" height="18" rx="9" fill="#3a302a" />
        <rect x="70" y="60" width="60" height="108" rx="14" fill="#c98b5e" />
        <rect x="70" y="60" width="60" height="108" rx="14" fill={`url(#${id}sh)`} />
        <rect x="80" y="98" width="40" height="40" rx="4" fill="#f8efe6" />
        <rect x="86" y="108" width="28" height="4" rx="2" fill="#2b2420" />
        <rect x="90" y="117" width="20" height="3" rx="1.5" fill="#9a7a62" />
        <rect x="92" y="125" width="16" height="3" rx="1.5" fill="#9a7a62" />
      </g>
    )
  }
  {
    kind === "cream" && (
      <g>
        <rect x="56" y="78" width="88" height="26" rx="8" fill="#1f2a33" />
        <rect x="52" y="100" width="96" height="68" rx="16" fill="#f7fafb" />
        <rect x="52" y="100" width="96" height="68" rx="16" fill={`url(#${id}sh)`} />
        <rect x="74" y="122" width="52" height="5" rx="2.5" fill="#1f2a33" />
        <rect x="84" y="133" width="32" height="3" rx="1.5" fill="#8aa0ad" />
      </g>
    )
  }
  {
    kind === "candle" && (
      <g>
        <path d="M100 44c7 9 8 16 0 24-8-8-7-15 0-24z" fill="#f5a524" />
        <path d="M100 52c3 5 3 9 0 13-3-4-3-8 0-13z" fill="#fff3c4" />
        <rect x="98.5" y="66" width="3" height="10" fill="#3a3a3a" />
        <rect x="62" y="76" width="76" height="92" rx="12" fill="#3f4a3c" />
        <rect x="62" y="76" width="76" height="92" rx="12" fill={`url(#${id}sh)`} />
        <rect x="62" y="76" width="76" height="12" rx="6" fill="#efe4d0" />
        <rect x="76" y="114" width="48" height="30" rx="4" fill="#efe4d0" />
        <rect x="84" y="124" width="32" height="4" rx="2" fill="#3f4a3c" />
        <rect x="90" y="132" width="20" height="3" rx="1.5" fill="#8b8a73" />
      </g>
    )
  }
  {
    kind === "mug" && (
      <g>
        <path d="M134 92h8a18 18 0 0 1 0 36h-8" fill="none" stroke="#d9cfc2" stroke-width="10" />
        <rect x="58" y="78" width="80" height="90" rx="14" fill="#e9e1d6" />
        <rect x="58" y="78" width="80" height="90" rx="14" fill={`url(#${id}sh)`} />
        <rect x="58" y="78" width="80" height="20" rx="10" fill="#c46a4a" />
        <circle cx="98" cy="128" r="14" fill="none" stroke="#c46a4a" stroke-width="4" />
      </g>
    )
  }
  {
    kind === "tote" && (
      <g>
        <path d="M80 80V64a20 20 0 0 1 40 0v16" fill="none" stroke="#3b3550" stroke-width="7" stroke-linecap="round" />
        <path d="M56 80h88l-6 88H62z" fill="#efe8dc" />
        <path d="M56 80h88l-6 88H62z" fill={`url(#${id}sh)`} />
        <rect x="80" y="110" width="40" height="30" rx="4" fill="#6b5ca5" />
        <path d="M90 125l7 7 13-14" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    kind === "soap" && (
      <g>
        <rect x="46" y="112" width="108" height="56" rx="18" fill="#e7d3ad" />
        <rect x="46" y="112" width="108" height="56" rx="18" fill={`url(#${id}sh)`} />
        <rect x="56" y="78" width="88" height="44" rx="16" fill="#f6ead2" />
        <rect x="56" y="78" width="88" height="44" rx="16" fill={`url(#${id}sh)`} />
        <text x="100" y="106" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="800" fill="#a88a5a" letter-spacing="2">OAT</text>
      </g>
    )
  }
  {
    kind === "bottle" && (
      <g>
        <rect x="86" y="30" width="28" height="12" rx="3" fill="#1d2b36" />
        <path d="M84 42h32l-2 14H86z" fill="#1d2b36" />
        <rect x="64" y="56" width="72" height="112" rx="20" fill="#5d8aa8" />
        <rect x="64" y="56" width="72" height="112" rx="20" fill={`url(#${id}sh)`} />
        <rect x="76" y="92" width="48" height="50" rx="6" fill="#f2f7fa" />
        <rect x="84" y="104" width="32" height="5" rx="2.5" fill="#1d2b36" />
        <rect x="88" y="115" width="24" height="3" rx="1.5" fill="#7f9db0" />
        <rect x="90" y="123" width="20" height="3" rx="1.5" fill="#7f9db0" />
      </g>
    )
  }
  {
    kind === "tee" && (
      <g>
        <path d="M74 48l-34 18 12 26 14-6v82h68V86l14 6 12-26-34-18c-4 10-14 16-26 16s-22-6-26-16z" fill="#2e2a2a" />
        <path d="M74 48l-34 18 12 26 14-6v82h68V86l14 6 12-26-34-18c-4 10-14 16-26 16s-22-6-26-16z" fill={`url(#${id}sh)`} />
        <circle cx="100" cy="112" r="16" fill="none" stroke="#e8c9c9" stroke-width="4" />
      </g>
    )
  }
</svg>
