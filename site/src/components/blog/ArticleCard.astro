---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { articlePath, readingMinutes, type Article } from "../../lib/content";
interface Props {
  article: Article;
}
const { article: a } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>("../../assets/**/*.jpg", { eager: true });
const img = all[`../../assets/${a.data.cover}.jpg`]?.default;
const date = a.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<a class="acard" href={articlePath(a)}>
  {img && <Image src={img} alt="" widths={[360, 560]} sizes="(min-width: 980px) 360px, (min-width: 640px) 45vw, 100vw" loading="lazy" />}
  <span class="acard__text">
    <span class="pill">{a.data.category}</span>
    <b>{a.data.title}</b>
    <span class="muted">{a.data.description}</span>
    <small>{date} · {readingMinutes(a.body ?? "")} min read</small>
  </span>
</a>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .acard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .acard :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 700;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--line);
  }
  .acard__text {
    display: grid;
    gap: 8px;
    justify-items: start;
    padding: 16px 18px 18px;
    flex: 1;
  }
  .acard__text b {
    font-size: 1.1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .acard__text .muted {
    font-size: 0.92rem;
  }
  small {
    margin-top: auto;
    color: var(--muted);
  }
</style>
