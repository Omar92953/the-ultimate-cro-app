---
/**
 * The main call to action. Goes to the App Store listing with UTM tags, or to "Get notified"
 * while the listing isn't live (see INSTALL_URL in lib/site.ts).
 */
import ShopifyLogo from "./ShopifyLogo.astro";
import { installHref, INSTALL_URL } from "../lib/site";
interface Props {
  /** Page type for utm_medium (home, pricing, article…). */
  medium: string;
  /** Page slug for utm_campaign. */
  campaign: string;
  label?: string;
  class?: string;
}
const { medium, campaign, label = "Install for free on Shopify", class: cls = "primary" } = Astro.props;
const live = Boolean(INSTALL_URL);
---

<a class:list={["btn", cls]} href={installHref(medium, campaign)} {...live ? { rel: "noopener" } : {}}>
  <ShopifyLogo />
  {label}
</a>
