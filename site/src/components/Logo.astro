---
/** The CRO Toolbox mark and wordmark (from branding/), drawn inline so it follows the text color. */
interface Props { class?: string }
const { class: cls } = Astro.props;
---

<span class:list={["logo", cls]}>
  <svg viewBox="0 0 100 100" aria-hidden="true"><g fill="currentColor"><rect x="10" y="60" width="20" height="30" rx="5"></rect><rect x="40" y="42" width="20" height="48" rx="5"></rect><path d="M70 34 H64 L80 10 L96 34 H90 V85 Q90 90 85 90 H75 Q70 90 70 85 Z"></path></g></svg>
  <span><b>CRO</b> Toolbox</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1.22rem;
    letter-spacing: -0.04em;
    font-weight: 500;
    white-space: nowrap;
  }
  .logo b {
    font-weight: 800;
  }
  svg {
    width: 26px;
    height: 26px;
  }
</style>
