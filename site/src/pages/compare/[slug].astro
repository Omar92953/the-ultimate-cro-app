---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Faq, { type QA } from "../../components/Faq.astro";
import InstallButton from "../../components/InstallButton.astro";
import NotifyCta from "../../components/NotifyCta.astro";
import { COMPETITORS, CAPABILITIES, OURS, checkedText, type Competitor } from "../../lib/competitors";
import { ORDER_GRACE_DAYS } from "../../../../app/lib/plans";
import { COMPARE_PAGES, MORE_PAGES } from "../../lib/pages";
import { plans, money, ordersText, trialDays, PLANS } from "../../lib/app";
import { faqPage } from "../../lib/schema";

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: `cro-toolbox-vs-${c.slug}` }, props: { c } }));
}
interface Props {
  c: Competitor;
}
const { c } = Astro.props;
const page = COMPARE_PAGES.find((p) => p.path === `/compare/cro-toolbox-vs-${c.slug}/`)!;
const crumbs = [
  { name: "Compare", href: MORE_PAGES.compare.path },
  { name: `vs ${c.name}`, href: page.path },
];
const ourPricing = plans.map((p) => (p.monthly ? `${p.name} ${money(p.monthly)} a month (${ordersText(p).toLowerCase()})` : `${p.name}: ${ordersText(p).toLowerCase()}, ${p.limits.offerSlots} offers at once`));
const levelText = c.level === "vendor" ? "from the app's own Shopify App Store listing or website" : "from review sites, which are often out of date";
const checked = checkedText(c.checked);
const ours = c.ours ?? "CRO Toolbox brings offers, bundles, storefront sections, cart offers and checkout rules into one app.";
const missing = c.missing ?? "Not on its listing";
/** Offer apps compare on the shared capabilities; apps for another job on their own rows. */
const rows = c.rows ?? CAPABILITIES.map((cap) => ({ label: cap.label, ours: OURS[cap.key] ? "Yes" : "No", theirs: c.has![cap.key] }));
const ourEdge = c.ourEdge ?? ["Offers, bundles, storefront sections and checkout rules in one app and one plan", "A free plan, then paid plans as your store grows", "Works with Online Store 2.0 themes without editing code"];
const faq: QA[] = [
  {
    q: `What is the difference between CRO Toolbox and ${c.name}?`,
    a: `${c.ours ?? "CRO Toolbox is one app for offers, six kinds of bundles, storefront sections, cart offers and checkout rules."} ${c.name} focuses on: ${c.focus.charAt(0).toLowerCase() + c.focus.slice(1)}`,
  },
  {
    q: `How much does CRO Toolbox cost compared with ${c.name}?`,
    a: `CRO Toolbox has a ${PLANS.free.name} plan and paid plans from ${money(plans.find((p) => p.monthly)!.monthly)} a month, each with a ${trialDays} day trial. For ${c.name}, check its current listing; the prices we found are on this page with their source.`,
  },
];
// Apps for the same job first.
const others = [...COMPETITORS.filter((x) => x.slug !== c.slug && x.area === c.area), ...COMPETITORS.filter((x) => x.area !== c.area)];
---

<Base page={page} crumbs={crumbs} schema={[faqPage(faq)]}>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={crumbs} />
      <span class="eyebrow">Compare</span>
      <h1>CRO Toolbox vs {c.name}</h1>
      <p class="lead">
        {ours} {c.name} focuses on: {c.focus.charAt(0).toLowerCase() + c.focus.slice(1)}
      </p>
      <p class="note">
        Facts about {c.name} are {levelText}, checked on {checked}. Where its sources don't mention something, the table says so. Always confirm on <a href={c.listing} rel="nofollow noopener" target="_blank">the {c.name} listing on the Shopify App Store</a>.
      </p>
    </div>
  </section>

  <section class="section tight mist">
    <div class="wrap">
      <h2 class="h2s">What each app covers</h2>
      <div class="table-scroll">
        <table class="cmp">
          <caption class="sr-only">Features of CRO Toolbox and {c.name}</caption>
          <thead><tr><th scope="col">Feature</th><th scope="col">CRO Toolbox</th><th scope="col">{c.name}</th></tr></thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.ours === "Yes" ? <span class="yes">Yes</span> : r.ours}</td>
                  <td>{r.theirs === true ? <span class="yes">Yes, listed</span> : r.theirs === false ? <span class="unk">{missing}</span> : r.theirs}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted">
        About {c.name}: "Yes, listed" means its {c.missing ? "pricing page" : "Shopify App Store listing"} says so (description, feature list or plans). "{missing}" means it doesn't mention it; the app may still do it, so ask its developer. Checked {checked}.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap grid two">
      <div class="block">
        <h2 class="h2s">CRO Toolbox pricing</h2>
        <ul class="check-list">{ourPricing.map((l) => <li>{l}</li>)}</ul>
        <p class="small muted">
          The orders limit counts all of a store's orders in a calendar month. Go over it and the app reminds you for {ORDER_GRACE_DAYS} days; after that, no new offers can be switched on until you move up a plan. Offers already on keep running.
        </p>
        <p class="small muted">Yearly billing is cheaper. Every paid plan has a {trialDays} day free trial. <a class="link" href="/pricing/">Full pricing</a></p>
      </div>
      <div class="block">
        <h2 class="h2s">{c.name} pricing, as reported</h2>
        <ul class="plain">{c.pricing.map((l) => <li>{l}</li>)}</ul>
        {c.rating && <p class="small">Listing rating: {c.rating}.</p>}
        <p class="small muted">
          Source: {
            c.sources.map((s, i) => (
              <>
                {i > 0 && ", "}
                <a href={s.url} rel="nofollow noopener" target="_blank">
                  {s.label}
                </a>
              </>
            ))
          }. Checked {checked}.
        </p>
      </div>
    </div>
  </section>

  <section class="section tight mist">
    <div class="wrap grid two">
      <div class="block">
        <h2 class="h2s">Where CRO Toolbox is stronger</h2>
        <ul class="check-list">{ourEdge.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="block">
        <h2 class="h2s">Where {c.name} is stronger</h2>
        <ul class="plain">{c.theirEdge.map((t) => <li>{t}</li>)}</ul>
        <p class="small muted">If you already use {c.name} and it works well for your store, that counts too.</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="head center"><h2>Questions</h2></div>
      <Faq items={faq} />
      <p class="center-actions"><InstallButton medium="compare" campaign={c.slug} /></p>
      <h2 class="h2s more">Other comparisons</h2>
      <ul class="others">{others.map((o) => <li><a class="btn ghost small" href={`/compare/cro-toolbox-vs-${o.slug}/`}>vs {o.name}</a></li>)}</ul>
    </div>
  </section>
  <NotifyCta campaign={`compare_${c.slug}`} />
</Base>

<style>
  .h2s {
    font-size: 1.4rem;
    margin-bottom: 16px;
  }
  .note {
    margin-top: 20px;
    max-width: 760px;
  }
  .note a {
    color: var(--accent-deep);
    font-weight: 600;
  }
  .cmp {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    background: #fff;
    font-size: 0.95rem;
  }
  .table-scroll {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .cmp th,
  .cmp td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--mist-2);
    text-align: left;
  }
  .cmp thead th {
    background: var(--mist);
    font-weight: 750;
  }
  .cmp tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cmp th[scope="row"] {
    font-weight: 550;
  }
  .yes {
    color: var(--accent-deep);
    font-weight: 700;
  }
  .unk {
    color: var(--muted);
  }
  .small {
    font-size: 0.88rem;
    margin-top: 12px;
  }
  .small a {
    color: var(--accent-deep);
  }
  .plain {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  .center-actions {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }
  .more {
    margin-top: 48px;
  }
  .others {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
