---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import NotifyCta from "../../components/NotifyCta.astro";
import { guides, guideMeta, guidePath, HELP_PAGE, type Guide } from "../../lib/content";
import { featurePath } from "../../lib/pages";
import { featureTitle, type FeatureKey } from "../../lib/app";

export async function getStaticPaths() {
  return (await guides()).map((g) => ({ params: { slug: g.id }, props: { g } }));
}
interface Props {
  g: Guide;
}
const { g } = Astro.props;
const { Content, headings } = await render(g);
const page = guideMeta(g);
const crumbs = [
  { name: "Help center", href: HELP_PAGE.path },
  { name: g.data.title, href: page.path },
];
const all = await guides();
const i = all.findIndex((x) => x.id === g.id);
const prev = all[i - 1];
const next = all[i + 1];
const toc = headings.filter((h) => h.depth === 2);
---

<Base page={page} crumbs={crumbs}>
  <section class="page-hero">
    <div class="wrap narrow">
      <Crumbs items={crumbs} />
      <span class="eyebrow">Help center</span>
      <h1>{g.data.title}</h1>
      <p class="lead">{g.data.description}</p>
      {toc.length > 2 && <ol class="toc">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>}
    </div>
  </section>
  <section class="section tight">
    <div class="wrap narrow">
      <div class="prose guide"><Content /></div>
      {
        g.data.features.length > 0 && (
          <div class="feats">
            <p>Feature pages:</p>
            <ul>{g.data.features.map((k) => <li><a class="btn ghost small" href={featurePath(k as FeatureKey)}>{featureTitle(k as FeatureKey)}</a></li>)}</ul>
          </div>
        )
      }
      <nav class="pager" aria-label="More guides">
        {prev ? <a href={guidePath(prev)}>← {prev.data.title}</a> : <span />}
        {next && <a href={guidePath(next)}>{next.data.title} →</a>}
      </nav>
    </div>
  </section>
  <NotifyCta campaign={`help_${g.id}`} />
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .toc {
    margin: 22px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
  }
  .toc a {
    color: var(--accent-deep);
  }
  .guide {
    max-width: none;
  }
  .guide :global(h2) {
    scroll-margin-top: 96px;
  }
  .feats {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .feats p {
    font-weight: 700;
    margin-bottom: 10px;
  }
  .feats ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    font-weight: 600;
  }
  .pager a {
    color: var(--accent-deep);
    text-decoration: none;
  }
  .pager a:hover {
    text-decoration: underline;
  }
</style>
