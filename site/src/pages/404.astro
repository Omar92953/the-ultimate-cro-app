---
import Base from "../layouts/Base.astro";
import { NAV } from "../lib/site";
const page = { slug: "home", path: "/404.html", title: "Page not found", description: "This page doesn't exist. Find CRO Toolbox features and pricing from here." };
---

<Base page={page} noindex>
  <section class="section">
    <div class="wrap nf">
      <span class="eyebrow">404</span>
      <h1>This page doesn't exist</h1>
      <p class="lead">The link may be old or mistyped. These pages might help:</p>
      <div class="actions">
        <a class="btn primary" href="/">Go to the home page</a>
        {NAV.map((l) => <a class="btn ghost" href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    max-width: 760px;
  }
  .nf h1 {
    margin-bottom: 16px;
  }
  .nf .lead {
    margin: 0 auto;
  }
  .actions {
    justify-content: center;
    margin-top: 32px;
  }
</style>
