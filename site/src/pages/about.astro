---
/** /about/: who runs CRO Toolbox, what it is, how it's priced, where data is kept and how to get in touch. */
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import InstallButton from "../components/InstallButton.astro";
import { PAGES, areaPath } from "../lib/pages";
import { SITE_AREAS, FEATURE_KEYS, plans, money, trialDays } from "../lib/app";
import { BRAND_LINE } from "../lib/brand";
import { OPERATOR, SUPPORT_EMAIL, INFO_EMAIL, FEATURES_EMAIL, SITE_URL } from "../lib/site";
import { organization } from "../lib/schema";

const page = PAGES.about;
const crumbs = [{ name: "About", href: page.path }];
const priceLine = plans.map((p) => (p.monthly ? `${p.name} ${money(p.monthly)} a month or ${money(p.yearly)} a year` : `${p.name}`)).join(", ");
const schema = [{ "@context": "https://schema.org", "@type": "AboutPage", name: page.title, url: new URL(page.path, SITE_URL).toString(), mainEntity: organization() }];
const contacts = [
  { email: SUPPORT_EMAIL, what: "Help with the app: setup, a problem on your store, billing." },
  { email: INFO_EMAIL, what: "General questions, partnerships and press." },
  { email: FEATURES_EMAIL, what: "Feature requests and ideas." },
].filter((c) => c.email);
---

<Base page={page} crumbs={crumbs} schema={schema}>
  <section class="page-hero">
    <div class="wrap narrow">
      <Crumbs items={crumbs} />
      <span class="eyebrow">About</span>
      <h1>About CRO Toolbox</h1>
      <p class="lead">
        {BRAND_LINE} It brings {FEATURE_KEYS.length} features for offers, bundles, tracking and returns, storefront sections, the cart and checkout into one app with one
        menu, for any Online Store 2.0 theme.
      </p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap narrow prose">
      <h2>Who runs it</h2>
      <p>
        CRO Toolbox is made and run by {OPERATOR}, a Shopify Partner. It is an independent app: Shopify is a trademark of Shopify Inc., and CRO Toolbox is not made by
        or affiliated with Shopify.
      </p>

      <h2>What it does</h2>
      <ul>
        {
          SITE_AREAS.map((a) => (
            <li>
              <a href={areaPath(a.key)}>{a.title}</a>: {a.intro}
            </li>
          ))
        }
      </ul>
      <p>Everything is set up in the app with a live preview and placed in the theme editor, without editing your theme's code.</p>

      <h2>How it's priced</h2>
      <p>
        Plans: {priceLine}. Every paid plan has a {trialDays} day free trial. Shopify bills the plan with your Shopify invoice, and you change or cancel it from the app.
        See <a href={PAGES.pricing.path}>pricing</a> for what each plan includes.
      </p>

      <h2>Where your data is kept</h2>
      <ul>
        <li>The app's settings are saved in your own Shopify store.</li>
        <li>The app's database holds only what it needs to work, such as login sessions, back in stock requests and return requests. It never stores shoppers' names, phone numbers or full addresses.</li>
        <li>When you uninstall, Shopify asks for your store's data to be deleted, and it is.</li>
      </ul>
      <p>Details: <a href={PAGES.privacy.path}>privacy policy</a> and <a href={PAGES.terms.path}>terms of service</a>.</p>

      <h2>How this site is written</h2>
      <ul>
        <li>Prices, plans and features on these pages are read from the app's own code, so they match the app.</li>
        <li>No invented reviews, ratings, customer logos or results.</li>
        <li>Comparisons with other apps state only facts with a source and the date they were checked.</li>
      </ul>

      <h2>Contact</h2>
      <ul>
        {
          contacts.map((c) => (
            <li>
              <a href={`mailto:${c.email}`}>{c.email}</a>: {c.what}
            </li>
          ))
        }
      </ul>
      <p>Setup guides are in the <a href="/help/">help center</a>, and the <a href={PAGES.support.path}>support page</a> says what to include in a message.</p>
      <p class="cta"><InstallButton medium="about" campaign="about" /></p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .prose > h2:first-child {
    margin-top: 0;
  }
  .cta {
    margin-top: 32px;
  }
</style>
