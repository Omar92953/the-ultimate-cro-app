---
/** /changelog/: what changed in the app, newest first (lib/changelog.ts). */
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import { PAGES } from "../lib/pages";
import { CHANGELOG } from "../lib/changelog";

const page = PAGES.changelog;
const crumbs = [{ name: "Changelog", href: page.path }];
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base page={page} crumbs={crumbs}>
  <section class="page-hero">
    <div class="wrap narrow">
      <Crumbs items={crumbs} />
      <span class="eyebrow">Changelog</span>
      <h1>What's new in CRO Toolbox</h1>
      <p class="lead">Changes to the app, newest first, dated by when they were finished. Changes to your storefront reach stores with the next app release.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap narrow">
      <ol class="log">
        {
          CHANGELOG.map((e) => (
            <li>
              <article>
                <time datetime={e.date}>{fmt(e.date)}</time>
                <h2>{e.title}</h2>
                <ul class="check-list">
                  {e.items.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
      <p class="more">What each feature does: <a class="link" href="/features/">all features</a>. Questions: <a class="link" href="/support/">support</a>.</p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 40px;
  }
  .log article {
    border-left: 3px solid var(--line);
    padding-left: 20px;
  }
  time {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  .log h2 {
    font-size: 1.4rem;
    margin: 6px 0 14px;
  }
  .more {
    margin-top: 40px;
  }
</style>
