---
import Base from "../layouts/Base.astro";
import InstallButton from "../components/InstallButton.astro";
import HeroMock from "../components/HeroMock.astro";
import MiniDemo from "../components/MiniDemo.astro";
import PlanCards from "../components/PlanCards.astro";
import Faq, { type QA } from "../components/Faq.astro";
import NotifyCta from "../components/NotifyCta.astro";
import Shot from "../components/Shot.astro";
import ArticleCard from "../components/blog/ArticleCard.astro";
import { PAGES } from "../lib/pages";
import { SITE_AREAS, OFFER_TYPES, featureTitle, featureAbout, plain, plans, cheapestPaid, money, trialDays, PLANS, GUARANTEE, type FeatureKey } from "../lib/app";
import { organization, website, softwareApplication, faqPage } from "../lib/schema";
import { featurePath, areaPath } from "../lib/pages";
import { articles, BLOG_PAGE } from "../lib/content";

const page = PAGES.home;
const free = PLANS.free;

/** The strip of feature cards, each with a small picture of what it adds to a store. */
const STRIP: FeatureKey[] = ["bundles", "upsell", "cross_sell", "cart_offers", "reviews", "countdown", "shipping_bar", "sticky_atc", "sales_pop", "videos", "wishlist", "faq"];

/**
 * "Why CRO Toolbox" rows. `shot` = the app screenshot for the row: site/src/assets/app/<name>.png.
 * TODO(Omar): send these three app screenshots; until then the closest feature picture (`fallback`) shows.
 *   app/one-menu      the app's Home or menu with Offers, Section library, Tracking & Returns, Cart & Checkout, Analytics (fallback: features/upsell)
 *   app/checkout-price an offer's preview next to the price at checkout (fallback: features/discounts)
 *   app/theme-editor  the theme editor with a CRO Toolbox block being placed (fallback: features/header)
 */
/** Every kind of offer, grouped like the app's Offers menu, with where each one is explained on the site. */
const OFFER_GROUPS: { title: string; types: { key: keyof typeof OFFER_TYPES; href: string }[] }[] = [
  { title: "Upsell", types: [{ key: "upsell", href: featurePath("upsell") }, { key: "upgrade", href: featurePath("upsell") }, { key: "post_purchase", href: featurePath("post_purchase") }] },
  { title: "Bundles", types: [{ key: "fixed", href: "/bundles/#fbt" }, { key: "kit", href: "/bundles/#kit" }, { key: "bundle", href: "/bundles/#mixmatch" }] },
  { title: "Cross sell", types: [{ key: "cross_sell", href: featurePath("cross_sell") }] },
  { title: "Discounts", types: [{ key: "bogo", href: featurePath("discounts") }, { key: "volume", href: featurePath("discounts") }, { key: "gift", href: featurePath("discounts") }] },
];
/** One line per offer type for the home page (the feature pages keep the full text from offer-types.ts). */
const OFFER_SHORT: Partial<Record<keyof typeof OFFER_TYPES, string>> = {
  upsell: '"Buy 2, save 10%" or a bigger size.',
  upgrade: "A better option in place of the one chosen.",
  post_purchase: "One click offer right after payment.",
  fixed: "Chosen products sold together at a discount.",
  kit: "A set sold as its own product.",
  bundle: "Shoppers build a set at one price.",
  cross_sell: '"Pairs well with" products, added in one click.',
  bogo: "Buy some, get others free or discounted.",
  volume: "The more they buy, the bigger the discount.",
  gift: "A free gift once the cart reaches an amount.",
};
const offerCount = OFFER_GROUPS.reduce((n, g) => n + g.types.length, 0);
const COUNT_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];

const VALUES = [
  {
    title: "One app instead of many",
    text: "Offers, bundles, cart offers, reviews, bars, timers and checkout rules share one menu, one design style and one plan.",
    shot: "app/one-menu",
    fallback: "features/upsell",
    alt: "The CRO Toolbox menu: offers, tracking and returns, section library, cart and checkout, and analytics",
  },
  {
    title: "Real discounts at checkout",
    text: "Shopify applies every offer and bundle price at checkout, so the price shoppers see on the offer is the price they pay.",
    shot: "app/checkout-price",
    fallback: "features/discounts",
    alt: "An offer with its discount shown to the shopper",
  },
  {
    title: "Fits your theme, no code",
    text: "Sections and widgets are theme app blocks for any Online Store 2.0 theme. You place them in the theme editor; your theme's code is never edited.",
    shot: "app/theme-editor",
    fallback: "features/header",
    alt: "A CRO Toolbox section placed in a store's theme",
  },
];

const STEPS = [
  { title: "Install the app", text: `Install CRO Toolbox from the Shopify App Store. The ${free.name} plan needs no card.` },
  { title: "Pick a feature", text: "Create an offer or open a storefront feature. Set it up on the left and watch the live preview on the right." },
  { title: "It shows in your theme", text: "Click Add to theme. The theme editor opens with the block ready: drag it where you want and save." },
];

const latest = (await articles()).slice(0, 3);

const paid = plans.filter((p) => p.monthly > 0);
const faq: QA[] = [
  {
    q: "What is CRO Toolbox?",
    a: "CRO Toolbox is a Shopify app that brings upsells, cross sells, bundles, discounts, cart offers, storefront widgets and checkout rules into one app with one menu. It helps a store sell more per order and turn more visits into orders.",
  },
  {
    q: "Which Shopify themes does CRO Toolbox work with?",
    a: "CRO Toolbox works with any Online Store 2.0 theme. Its sections and widgets are theme app blocks and app embeds that you place in the theme editor, so it never edits your theme's code.",
  },
  {
    q: "Do I need to write code?",
    a: "No. You set everything up in the app with a live preview, then click Add to theme and place the block in the theme editor.",
  },
  {
    q: "How much does CRO Toolbox cost?",
    a: `CRO Toolbox has a ${free.name} plan and three paid plans: ${paid.map((p) => `${p.name} ${money(p.monthly)} a month (${money(p.yearly)} a year)`).join(", ")}. See <a href="/pricing/">pricing</a> for what each plan includes.`,
  },
  {
    q: "Is there a free trial?",
    a: `Yes. Every paid plan starts with a ${trialDays} day free trial, and the ${free.name} plan is free with no time limit.`,
  },
  {
    q: "What happens if my store goes over its orders limit?",
    a: "Nothing switches off. The limit counts all store orders in a calendar month and is soft: the app shows a reminder to move up a plan.",
  },
  {
    q: "Are offer and bundle discounts applied at checkout?",
    a: "Yes. Discounts run as Shopify discounts at checkout, and bundles are merged into one cart line at the bundle price, so the price on the offer is the price the shopper pays.",
  },
  {
    q: "How do the widgets load on my store?",
    a: "Widgets are theme app blocks that read your store's own data as the page loads, so showing an offer doesn't wait on an outside server. Only forms shoppers send, such as reviews, back in stock requests and returns, go to the app's server through Shopify. Checkout logic runs inside Shopify Functions.",
  },
  {
    q: "Where are my settings stored?",
    a: "In your own store, as app data Shopify keeps for you. The app's database only holds login sessions, back in stock requests and return requests.",
  },
  {
    q: "Can I cancel or change plans anytime?",
    a: `${GUARANTEE} Nothing is deleted: offers over a lower plan's limit are switched off and come back on when you upgrade.`,
  },
];

const schema = [organization(), website(), softwareApplication(page.description), faqPage(faq)];
---

<Base page={page} schema={schema}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="pill">Shopify app · Any Online Store 2.0 theme</span>
        <h1>Increase AOV and LTV. <span class="soft">All in one Shopify app.</span></h1>
        <p class="lead">
          Upsells, bundles and cart offers raise your average order value (AOV). A Track page that sells the next order and returns that keep
          the sale raise your customers' lifetime value (LTV). Set up in minutes with a live preview, added to your theme without code.
        </p>
        <div class="actions">
          <InstallButton medium="home" campaign="hero" />
          <a class="btn ghost" href="/features/">See all features <span aria-hidden="true">→</span></a>
        </div>
        <ul class="trust">
          <li>Built for any Online Store 2.0 theme</li>
          <li>{free.name} plan, paid from {money(cheapestPaid.monthly)} a month</li>
          <li>{trialDays} day free trial</li>
        </ul>
      </div>
      <div class="hero-art">
        <HeroMock />
      </div>
    </div>
  </section>

  <!-- Feature strip -->
  <section class="section mist" id="tour">
    <div class="wrap">
      <div class="head strip-head">
        <span class="eyebrow">On your store</span>
        <h2>What CRO Toolbox adds to your store</h2>
        <p class="lead">Widgets and sections that sit in your theme like they were made for it. Scroll for more.</p>
      </div>
    </div>
    <ul class="strip" role="list">
      {
        STRIP.map((k) => (
          <li>
            <a class="feat" href={featurePath(k)}>
              <div class="feat-art">
                <MiniDemo kind={k} />
              </div>
              <div class="feat-text">
                <h3>{featureTitle(k)}</h3>
                <p>{featureAbout(k)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="wrap strip-foot">
      <a class="link" href="/features/">See every feature →</a>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Why CRO Toolbox</span>
        <h2>Every CRO tool a store needs to increase AOV, in one app</h2>
      </div>
      <div class="rows">
        {
          VALUES.map((v) => (
            <div class="row">
              <div class="row-shot">
                <Shot name={v.shot} fallback={v.fallback} alt={v.alt} />
              </div>
              <div class="row-text">
                <h3>{v.title}</h3>
                <p class="muted">{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Offers -->
  <section class="section mist" id="offers">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Offers</span>
        <h2>{COUNT_WORDS[offerCount] ? COUNT_WORDS[offerCount][0].toUpperCase() + COUNT_WORDS[offerCount].slice(1) : offerCount} kinds of offers, all on the {free.name} plan</h2>
        <p class="lead">Upsells, bundles, cross sells and discounts are included on every plan, within your plan's offer slots. Prices and discounts are applied at checkout by Shopify.</p>
      </div>
      <div class="ogroups" style={`--orows: ${1 + Math.max(...OFFER_GROUPS.map((g) => g.types.length))}`}>
        {
          OFFER_GROUPS.map((g) => (
            <div class="ogroup">
              <h3>{g.title}</h3>
              <ul>
                {g.types.map((t) => (
                  <li>
                    <a class="otype" href={t.href}>
                      <b>{plain(OFFER_TYPES[t.key].title)}</b>
                      <span class="muted">{OFFER_SHORT[t.key] ?? plain(OFFER_TYPES[t.key].about)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="all"><a class="link" href="/bundles/">See every bundle type →</a></p>
    </div>
  </section>

  <!-- Features by area -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Features</span>
        <h2>Offers, storefront, cart, checkout and analytics</h2>
        <p class="lead">The app's menu follows how a shopper moves through your store. Here is everything in it today.</p>
      </div>
      <div class="areas">
        {
          SITE_AREAS.map((a) => (
            <details class={`area area-${a.key}`} open data-area>
              <summary>
                <h3>{a.title}</h3>
                <span class="count">{a.key === "analytics" ? 4 : a.features.length}</span>
              </summary>
              <p class="muted">{a.intro}</p>
              <ul class="flist">
                {a.features.map((k) => (
                  <li>
                    <a href={featurePath(k)}>{featureTitle(k)}</a>
                  </li>
                ))}
                {a.key === "analytics" && (
                  <>
                    <li>Sales from the app</li>
                    <li>Results per offer</li>
                    <li>Results per bundle</li>
                    <li>Holdout test</li>
                  </>
                )}
              </ul>
              <a class="area-link" href={areaPath(a.key)}>All {a.title.toLowerCase()} features →</a>
            </details>
          ))
        }
      </div>
      <p class="all"><a class="btn ghost" href="/features/">See all features <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">How it works</span>
        <h2>Live on your store in three steps</h2>
        <p class="lead">No code, no theme edits, no developer.</p>
      </div>
      <ol class="steps">
        {
          STEPS.map((s, i) => (
            <li class="step">
              <span class="step-n">{i + 1}.</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section mist" id="pricing">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">Pricing</span>
        <h2>Start free. Upgrade when you grow.</h2>
        <p class="lead">Start on the Free plan. Paid plans add unlimited offers, every storefront tool, checkout control and results for every offer.</p>
      </div>
      <PlanCards medium="home" campaign="pricing" />
      <p class="center-link"><a class="link" href="/pricing/">Compare every plan in detail →</a></p>
    </div>
  </section>

  <!-- Guides teaser -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Guides</span>
        <h2>Learn what raises order value</h2>
        <p class="lead">Practical how to guides for Shopify stores, with real steps.</p>
      </div>
      <div class="grid three">{latest.map((a) => <ArticleCard article={a} />)}</div>
      <p class="center-link"><a class="link" href={BLOG_PAGE.path}>Read all guides →</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section mist" id="faq">
    <div class="wrap">
      <div class="head center">
        <span class="eyebrow">FAQ</span>
        <h2>Questions, answered</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <NotifyCta campaign="home" />
</Base>

<style>
  .hero {
    padding: clamp(40px, 7vw, 88px) 0 clamp(56px, 8vw, 96px);
    background:
      radial-gradient(60% 50% at 85% 20%, rgb(62 224 143 / 0.16), transparent 70%),
      radial-gradient(50% 40% at 0% 0%, rgb(11 11 15 / 0.04), transparent 70%);
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.02fr 1fr;
      gap: 56px;
    }
  }
  .hero h1 {
    margin: 22px 0 20px;
  }
  .hero .soft {
    color: #8b8d97;
  }
  .hero .actions {
    margin-top: 32px;
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .trust li::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-deep);
  }
  .hero-art {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
  }

  .strip-head {
    margin-bottom: 32px;
  }
  .strip {
    list-style: none;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(250px, 270px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))) 24px;
    scroll-padding: 0 max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    scrollbar-width: thin;
  }
  .strip > li {
    display: flex;
    scroll-snap-align: start;
  }
  .feat {
    display: flex;
    width: 100%;
    flex-direction: column;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .feat:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .feat-art {
    height: 200px;
    background: linear-gradient(160deg, #f1f1ec, #e6e6df);
  }
  .feat-text {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .feat-text p {
    font-size: 0.92rem;
    color: var(--muted);
    flex: 1;
  }
  .strip-foot {
    margin-top: 8px;
  }

  /* Why CRO Toolbox: picture and text side by side, swapping sides row by row. */
  .rows {
    display: grid;
    gap: clamp(48px, 7vw, 88px);
  }
  .row {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .row-text h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    margin-bottom: 12px;
  }
  .row-text p {
    font-size: 1.05rem;
    max-width: 460px;
  }
  @media (min-width: 860px) {
    .row {
      grid-template-columns: 1.15fr 1fr;
      gap: 64px;
    }
    .row:nth-child(even) .row-shot {
      order: 2;
    }
  }
  /* Offers: the four groups as columns, each a plain list with thin lines. */
  .ogroups {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 720px) {
    .ogroups {
      grid-template-columns: 1fr 1fr;
      column-gap: 48px;
    }
  }
  @media (min-width: 980px) {
    .ogroups {
      grid-template-columns: repeat(4, 1fr);
      column-gap: 32px;
      row-gap: 0;
    }
    /* The four groups share rows (title, then one row per offer type), so offers line up across the columns. */
    .ogroup {
      display: grid;
      grid-row: span var(--orows);
      grid-template-rows: subgrid;
    }
    .ogroup ul {
      display: contents;
    }
  }
  .ogroup h3 {
    font-size: 1.2rem;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .ogroup ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ogroup li {
    border-bottom: 1px solid var(--line);
  }
  .otype {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }
  .otype b {
    font-weight: 650;
  }
  .otype span {
    font-size: 0.92rem;
  }
  .otype:hover b {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Features by area: columns separated by thin rules, plain text links. */
  .areas {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .areas {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 48px;
    }
  }
  /* Wide screens: Offers beside the Section library (2 columns wide, its list in 3 columns), then Tracking &
     Returns, Cart & Checkout and Analytics on one row. */
  @media (min-width: 900px) {
    .area-library {
      grid-column: span 2;
    }
    .area-library .flist {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 32px;
    }
  }
  .area {
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--line);
  }
  .area > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    margin-bottom: 8px;
  }
  .area > summary::-webkit-details-marker {
    display: none;
  }
  .area h3 {
    font-size: 1.35rem;
  }
  .count {
    display: none;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  .area-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
  }
  /* Phones: each area folds into one row (title, number of features, chevron); tap to open. */
  @media (max-width: 899px) {
    .area {
      padding: 0;
    }
    .area > summary {
      cursor: pointer;
      margin: 0;
      padding: 20px 0;
    }
    .area > summary::after {
      content: "";
      margin-left: auto;
      width: 9px;
      height: 9px;
      border-right: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      transform: rotate(45deg) translateY(-3px);
      transition: transform 0.15s;
    }
    .area[open] > summary::after {
      transform: rotate(225deg) translateY(-3px);
    }
    .count {
      display: inline;
    }
    .area[open] {
      padding-bottom: 24px;
    }
    .area .flist {
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }
  }
  @media (min-width: 900px) {
    .area > summary {
      pointer-events: none;
    }
  }
  .area > p {
    font-size: 0.95rem;
  }
  .flist {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }
  .flist a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
  }
  .flist a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .all {
    margin-top: 36px;
  }
  /* How it works: plain numbers, no cards. */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 32px;
  }
  @media (min-width: 820px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
  }
  .step-n {
    display: block;
    font-size: 1.6rem;
    font-weight: 750;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .step h3 {
    margin-bottom: 8px;
  }
  .center-link {
    text-align: center;
    margin-top: 28px;
  }

</style>

<script>
  // Features by area: all open on wide screens; on phones they start folded so the list stays short.
  if (window.matchMedia("(max-width: 899px)").matches) {
    document.querySelectorAll<HTMLDetailsElement>("details[data-area]").forEach((d) => (d.open = false));
  }
</script>
