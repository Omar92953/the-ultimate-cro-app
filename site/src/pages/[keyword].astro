---
/**
 * Keyword pages (/shopify-upsell-app/, /shopify-cross-sell/…): one page answers one search.
 * Content: src/keywords/<slug>.ts, loaded by lib/keywords.ts. Paragraphs, list items and answers may
 * hold simple links (<a href="/…/">); everything else is plain text.
 */
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Shot from "../components/Shot.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Faq from "../components/Faq.astro";
import InstallButton from "../components/InstallButton.astro";
import NotifyCta from "../components/NotifyCta.astro";
import { KEYWORD_PAGES, keywordMeta, keywordPath, type KeywordPage } from "../lib/keywords";
import { planRows } from "../lib/plan-lines";
import { featurePath, MORE_PAGES, PAGES } from "../lib/pages";
import { USE_CASES } from "../lib/usecases";
import { articles, guides, articlePath, guidePath } from "../lib/content";
import { faqPage } from "../lib/schema";
import { demoUrl } from "../../../app/lib/site";

export function getStaticPaths() {
  return KEYWORD_PAGES.map((p) => ({ params: { keyword: p.slug }, props: { p } }));
}
interface Props {
  p: KeywordPage;
}
const { p } = Astro.props;
const page = keywordMeta(p);
const crumbs = [{ name: p.menu, href: keywordPath(p) }];

// Links to the help center, use cases and articles: fail the build on a slug that doesn't exist.
const allGuides = await guides();
const allArticles = await articles();
const need = <T,>(what: string, slug: string, found: T | undefined): T => {
  if (!found) throw new Error(`Keyword page ${p.slug}: no ${what} "${slug}"`);
  return found;
};
const helpLinks = p.help.map((s) => need("help guide", s, allGuides.find((g) => g.id === s)));
const useCaseLinks = p.useCases.map((s) => need("use case", s, USE_CASES.find((u) => u.slug === s)));
const articleLinks = p.articles.map((s) => need("article", s, allArticles.find((a) => a.id === s)));
const relatedPages = (p.related ?? []).map((s) => KEYWORD_PAGES.find((x) => x.slug === s)).filter((x): x is KeywordPage => Boolean(x));

// Demo pages are served by this site under /demo/ (noindex there); link them without passing rank.
const demos = p.demos.map((d) => ({ label: d.label, href: new URL(demoUrl(d.feature, undefined, d.recipe)).pathname }));
const plans = planRows(p.features);
const updated = new Date(`${p.updated}T12:00:00Z`);
const updatedText = updated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base page={page} crumbs={crumbs} schema={[faqPage(p.faq)]}>
  <section class="page-hero">
    <div class="wrap khero">
      <div>
        <Crumbs items={crumbs} />
        <span class="eyebrow">{p.kicker}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.answer}</p>
        <p class="updated">Last updated <time datetime={p.updated}>{updatedText}</time></p>
        <div class="actions">
          <InstallButton medium="keyword" campaign={p.slug} />
          <a class="btn ghost" href={PAGES.pricing.path}>See pricing</a>
        </div>
      </div>
      <Shot name={p.shot.name} alt={p.shot.alt} caption={p.shot.caption} eager />
    </div>
  </section>

  <section class="section tight">
    <div class="wrap prose">
      {
        p.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            {s.paragraphs?.map((t) => <p set:html={t} />)}
            {s.list && (
              <ul class="check-list">
                {s.list.map((t) => (
                  <li set:html={t} />
                ))}
              </ul>
            )}
            {s.steps && (
              <ol>
                {s.steps.map((t) => (
                  <li set:html={t} />
                ))}
              </ol>
            )}
            {s.after?.map((t) => <p set:html={t} />)}
          </>
        ))
      }
    </div>
  </section>

  {
    p.table && (
      <section class="section tight mist">
        <div class="wrap prose wide">
          <h2>{p.table.heading}</h2>
          <div class="table-scroll">
            <table class="kt">
              <caption class="sr-only">{p.table.caption}</caption>
              <thead>
                <tr>
                  {p.table.head.map((h) => (
                    <th scope="col">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {p.table.rows.map((r) => (
                  <tr>
                    {r.map((c, i) => (i === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {p.table.note && <p class="small" set:html={p.table.note} />}
        </div>
      </section>
    )
  }

  <section class="section tight">
    <div class="wrap prose wide">
      <h2>Which plan you need</h2>
      <div class="table-scroll">
        <table class="kt">
          <caption class="sr-only">The CRO Toolbox plan that unlocks each feature on this page</caption>
          <thead>
            <tr><th scope="col">Feature</th><th scope="col">Plan</th><th scope="col">Price and limits</th></tr>
          </thead>
          <tbody>
            {
              plans.map((r) => (
                <tr>
                  <th scope="row">
                    <a href={featurePath(r.key)}>{r.feature}</a>
                  </th>
                  <td>{r.plan} and above</td>
                  <td>{r.limits}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small">Prices in US dollars, billed by Shopify. Every plan and its limits: <a href={PAGES.pricing.path}>pricing</a>.</p>
    </div>
  </section>

  <section class="section tight mist">
    <div class="wrap">
      <div class="head">
        <h2>See it on a demo store</h2>
        <p class="lead">The live demos show the app's real storefront blocks on a sample store, so you can click through them before you install.</p>
      </div>
      <ul class="demos">
        {
          demos.map((d) => (
            <li>
              <a class="btn ghost" href={d.href} rel="nofollow" target="_blank">
                {d.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="grid three cards">{p.features.map((k) => <FeatureCard feature={k} />)}</div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <div class="head center"><h2>Questions</h2></div>
      <Faq items={p.faq} />
    </div>
  </section>

  <section class="section tight mist">
    <div class="wrap grid two">
      <nav class="block" aria-label="Set it up">
        <h2 class="h3">Set it up</h2>
        <ul class="links">
          {
            helpLinks.map((g) => (
              <li>
                <a class="link" href={guidePath(g)}>Help: {g.data.title}</a>
              </li>
            ))
          }
          {
            p.features.map((k) => (
              <li>
                <a class="link" href={featurePath(k)}>Feature: {plans.find((r) => r.key === k)!.feature}</a>
              </li>
            ))
          }
          <li><a class="link" href={PAGES.pricing.path}>Pricing and plans</a></li>
        </ul>
        <p class="install"><InstallButton medium="keyword" campaign={`${p.slug}_links`} label="Get CRO Toolbox on the Shopify App Store" /></p>
      </nav>
      <nav class="block" aria-label="Read next">
        <h2 class="h3">Read next</h2>
        <ul class="links">
          {
            useCaseLinks.map((u) => (
              <li>
                <a class="link" href={`/use-cases/${u.slug}/`}>Use case: {u.title}</a>
              </li>
            ))
          }
          {
            articleLinks.map((a) => (
              <li>
                <a class="link" href={articlePath(a)}>Guide: {a.data.title}</a>
              </li>
            ))
          }
          {
            relatedPages.map((r) => (
              <li>
                <a class="link" href={keywordPath(r)}>{r.h1}</a>
              </li>
            ))
          }
          <li><a class="link" href={MORE_PAGES.compare.path}>Compare CRO Toolbox with other apps</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <NotifyCta campaign={`keyword_${p.slug}`} />
</Base>

<style>
  .khero {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 980px) {
    .khero {
      grid-template-columns: 1fr 1.1fr;
    }
  }
  .updated {
    margin-top: 14px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .actions {
    margin-top: 24px;
  }
  .prose > h2:first-child {
    margin-top: 0;
  }
  .wide {
    max-width: 960px;
  }
  .small {
    font-size: 0.9rem;
    margin-top: 12px;
  }
  .demos {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .h3 {
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .install {
    margin-top: 22px;
  }
  /* Long button labels wrap instead of widening the page on phones. */
  .install :global(.btn) {
    white-space: normal;
    text-align: center;
  }
  .grid > .block {
    min-width: 0;
  }
  /* Tables keep readable columns and scroll sideways on phones, inside .table-scroll. */
  .kt {
    min-width: 560px;
    margin-bottom: 0;
  }
  .kt th,
  .kt td {
    overflow-wrap: normal;
  }
</style>
