{%- comment -%}
  App embed: quick add to cart on product cards (collections, home, search, recommendations).
  Product cards can't hold app blocks, so the button is placed on each card's image by JS.
  Designed in the app (Boosters → Quick add): $app:cro_design "quick_add".
{%- endcomment -%}
{%- liquid
  assign d = shop.metaobjects['$app:cro_design']['quick_add'].config.value
  if request.design_mode and shop.metaobjects['$app:cro_design']['quick_add_draft'].config.value
    assign d = shop.metaobjects['$app:cro_design']['quick_add_draft'].config.value
  endif
-%}
<script type="application/json" id="ucs-qa-config">
  {"fmt":{{ shop.money_format | json }},"d":{{ d | json | default: 'null' }},"t":{"choose":{{ 'ucs.choose' | t | json }},"sold_out":{{ 'ucs.sold_out' | t | json }},"close":{{ 'ucs.close' | t | json }},"error":{{ 'ucs.error' | t | json }}}}
</script>
<script src="{{ 'ucs-quick-add.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quick add to cart",
  "target": "body",
  "stylesheet": "ucs-quick-add.css",
  "settings": [
    { "type": "paragraph", "content": "Adds a button to every product card; products with sizes or colours open a small picker. The look is set in the app: Boosters → Quick add." }
  ]
}
{% endschema %}
