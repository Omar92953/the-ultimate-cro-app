{%- comment -%}
  App block: product finder quiz (Sections → Product quiz in the app, $app:cro_design "quiz").
  ucs-quiz.js asks the questions and recommends the products whose tags match the answers best.
{%- endcomment -%}
{%- capture dk -%}{%- render 'ucs-dk', key: 'quiz', pick: block.settings.design -%}{%- endcapture -%}
{%- assign dkd = dk | append: '_draft' -%}
{%- liquid
  assign d = shop.metaobjects['$app:cro_design'][dk].config.value
  if request.design_mode and shop.metaobjects['$app:cro_design'][dkd].config.value
    assign d = shop.metaobjects['$app:cro_design'][dkd].config.value
  endif
-%}
{%- if d -%}
  <div class="{{ d.cls }}" style="{{ d.css }}" data-ucs-quiz data-root="{{ routes.root_url }}" {{ block.shopify_attributes }}><script type="application/json">{{ d | json }}</script></div>
  <script src="{{ 'ucs-quiz.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Set up the quiz in the app: Section library → Product quiz.</p>
{%- endif -%}

{% schema %}
{
  "name": "Product quiz",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "select", "id": "design", "label": "Style", "default": "1", "info": "Which of the styles made in the app to show.", "options": [
      { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }
    ] },
    { "type": "paragraph", "content": "Questions, answers and the products they lead to are set in the app: Section library → Product quiz." }
  ]
}
{% endschema %}
