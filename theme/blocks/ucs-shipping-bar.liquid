{%- comment -%}
  App block: free shipping bar ("You're $12 away from free shipping" + progress). Designed in the app
  (Boosters → Free shipping bar), stored in $app:cro_design "shipping_bar"; ucs-shipping-bar.js builds
  it and keeps it in step with the cart. Works in the Header area, on product and cart pages.
{%- endcomment -%}
{%- assign c = shop.metaobjects['$app:cro_design']['shipping_bar'].config.value -%}
{%- if request.design_mode and shop.metaobjects['$app:cro_design']['shipping_bar_draft'].config.value -%}{%- assign c = shop.metaobjects['$app:cro_design']['shipping_bar_draft'].config.value -%}{%- endif -%}
{%- if c.on -%}
  <div class="ucs ucs-fsb" data-ucs-fsb data-total="{{ cart.total_price }}" data-page="{{ request.page_type }}" {{ block.shopify_attributes }} hidden><script type="application/json">{{ c | json }}</script></div>
  <script src="{{ 'ucs-shipping-bar.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Free shipping bar",
  "target": "section",
  "stylesheet": "ucs-shipping-bar.css",
  "settings": [
    { "type": "paragraph", "content": "Goal, messages, colours and where it shows are set in the app: Boosters → Free shipping bar." }
  ]
}
{% endschema %}
