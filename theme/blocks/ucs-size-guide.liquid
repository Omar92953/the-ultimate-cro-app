{%- comment -%}
  App block: size guide for the product page. Two links ("Size chart", "Size recommendation") that open a
  window with the chart and a size finder. Designed in the app (Section library → Size guide,
  $app:cro_design "size_guide"). The first chart whose products, collections or tags match this product
  is used; only that chart is put on the page. ucs-size-guide.js shows it.
{%- endcomment -%}
{%- liquid
  assign d = shop.metaobjects['$app:cro_design']['size_guide'].config.value
  if request.design_mode and shop.metaobjects['$app:cro_design']['size_guide_draft'].config.value
    assign d = shop.metaobjects['$app:cro_design']['size_guide_draft'].config.value
  endif
  assign at = -1
  if d and d.on != false and product
    for ch in d.charts
      if at == -1
        if ch.m.all
          assign at = forloop.index0
        elsif ch.m.products contains product.handle
          assign at = forloop.index0
        else
          assign chart_at = forloop.index0
          for tg in product.tags
            assign low = tg | downcase
            if ch.m.tags contains low
              assign at = chart_at
              break
            endif
          endfor
          if at == -1
            for co in product.collections
              if ch.m.collections contains co.handle
                assign at = chart_at
                break
              endif
            endfor
          endif
        endif
      endif
    endfor
    if at == -1 and request.design_mode
      assign at = 0
    endif
  endif
-%}
{%- if at > -1 -%}
  {%- assign pick = d.charts[at] -%}
  <div class="{{ d.cls }}" style="{{ d.css }}" data-ucs-sg data-place="{{ block.settings.place | default: d.place }}" hidden {{ block.shopify_attributes }}>
    <script type="application/json">{"t":{{ d.t | json }},"chart":{{ pick | json }}}</script>
  </div>
  <script src="{{ 'ucs-size-guide.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>Set up the size guide in the app: Section library → Size guide.</p>
{%- endif -%}

{% schema %}
{
  "name": "Size guide",
  "target": "section",
  "settings": [
    { "type": "select", "id": "place", "label": "Where the links go", "default": "", "options": [
      { "value": "", "label": "As set in the app" }, { "value": "picker", "label": "Under the size picker" }, { "value": "block", "label": "Where this block is" }
    ] },
    { "type": "paragraph", "content": "Put it inside the product information. The charts, texts and look are set in the app: Section library → Size guide." }
  ]
}
{% endschema %}
