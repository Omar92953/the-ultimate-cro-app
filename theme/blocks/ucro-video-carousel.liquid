{%- liquid
  assign cfg = shop.metaobjects['$app:cro_settings']['settings']
  assign enabled = true
  if cfg and cfg.videos_enabled.value == false
    assign enabled = false
  endif

  # Look, wording and where it shows are designed in the app (Video carousel → Design): $app:cro_design "videos".
  assign d = shop.metaobjects['$app:cro_design']['videos'].config.value
  if request.design_mode and shop.metaobjects['$app:cro_design']['videos_draft'].config.value
    assign d = shop.metaobjects['$app:cro_design']['videos_draft'].config.value
  endif
  assign heading = 'See it in action'
  assign sub = ''
  if d
    assign heading = d.h
    assign sub = d.sub
  endif

  assign show_here = true
  if d.so == 'only' or d.so == 'except'
    assign current_handle = ''
    case request.page_type
      when 'product'
        assign current_handle = product.handle
      when 'collection'
        assign current_handle = collection.handle
      when 'page'
        assign current_handle = page.handle
      when 'blog'
        assign current_handle = blog.handle
      when 'article'
        assign current_handle = article.handle
    endcase
    assign is_match = false
    if d.pt contains request.page_type
      assign is_match = true
    elsif current_handle != blank and d.hs contains current_handle
      assign is_match = true
    endif
    if d.so == 'only'
      assign show_here = is_match
    elsif is_match
      assign show_here = false
    endif
  endif

  assign slides = shop.metaobjects['$app:cro_carousel']['main'].slides.value

-%}

{%- if enabled and show_here and slides.size > 0 -%}
  <ucro-video-carousel
    class="ucro ucro-vc{{ d.cls }}"
    style="{{ d.css | default: '--ucro-pt: 36px; --ucro-pb: 36px;' }}"
    data-autoplay="{% if d.ap == false %}false{% else %}true{% endif %}"
    data-error="{{ 'ucro.error' | t | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <h2 class="ucro__heading {{ d.hc | default: 'ucro__heading--large' }}">{{ heading | escape }}</h2>
    {%- endif -%}
    {%- if sub != blank -%}
      <p class="ucro__sub">{{ sub | escape }}</p>
    {%- endif -%}

    {%- assign track_label = 'ucro.carousel' | t -%}
    {%- if heading != blank -%}{%- assign track_label = heading -%}{%- endif -%}
    <ul class="ucro-vc__track" role="list" tabindex="0" aria-roledescription="carousel" aria-label="{{ track_label | strip_html | escape }}">
      {%- for slide in slides -%}
        {%- liquid
          assign video = slide.video.value
          assign image = slide.image.value
          assign linked = slide.product.value
          assign caption = slide.caption.value
          assign label = caption | default: linked.title | default: video.alt | default: shop.name
        -%}
        <li class="ucro-vc__slide" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}">
          <div class="ucro-vc__card">
            <div class="ucro-vc__media"{% if linked == blank %} data-toggle-play{% endif %}>
              {%- if video != blank -%}
                {%- liquid
                  assign pick = nil
                  for s in video.sources
                    if s.mime_type != 'video/mp4'
                      continue
                    endif
                    if pick == nil
                      assign pick = s
                    elsif pick.height < 480 and s.height > pick.height
                      assign pick = s
                    elsif s.height >= 480 and s.height < pick.height
                      assign pick = s
                    endif
                  endfor
                -%}
                <video
                  class="ucro-vc__video"
                  muted
                  loop
                  playsinline
                  preload="none"
                  {% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 720 }}"{% endif %}
                  aria-label="{{ label | escape }}"
                  {% if pick %}data-src="{{ pick.url }}"{% endif %}
                ></video>
                {%- if linked == blank -%}
                  <span class="ucro-vc__play" aria-hidden="true"></span>
                {%- endif -%}
              {%- elsif image != blank -%}
                {{ image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 750px) 25vw, 70vw', alt: label }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ucro-placeholder' }}
              {%- endif -%}
            </div>
            {%- if caption != blank -%}
              <p class="ucro-vc__caption">{{ caption | escape }}</p>
            {%- endif -%}
            {%- if linked != blank -%}
              <a class="ucro-vc__link" href="{{ linked.url }}" aria-label="{{ linked.title | escape }}" tabindex="-1"></a>
            {%- endif -%}
          </div>

          {%- if linked != blank and d.sp != false -%}
            <div class="ucro-vc__product">
              <a class="ucro-vc__title" href="{{ linked.url }}">{{ linked.title | escape }}</a>
              <span class="ucro-vc__price" data-ucro-price>{{ linked.price | money }}</span>
              {%- if d.sa != false -%}
                {%- if linked.available and linked.has_only_default_variant -%}
                  <button type="button" class="ucro-btn ucro-vc__add" data-variant="{{ linked.first_available_variant.id }}">{{ d.al | default: 'Add to cart' | escape }}</button>
                {%- elsif linked.available -%}
                  <a class="ucro-btn ucro-vc__add" href="{{ linked.url }}">{{ 'ucro.choose_options' | t }}</a>
                {%- else -%}
                  <button type="button" class="ucro-btn ucro-vc__add" disabled>{{ 'ucro.sold_out' | t }}</button>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if d.ar != false and slides.size > 1 -%}
      <div class="ucro-vc__nav">
        <button type="button" class="ucro-vc__arrow" data-dir="-1" aria-label="{{ 'ucro.previous' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="ucro-vc__counter" aria-hidden="true"><span data-current>1</span> / {{ slides.size }}</span>
        <button type="button" class="ucro-vc__arrow" data-dir="1" aria-label="{{ 'ucro.next' | t }}">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {%- endif -%}
    <p class="ucro__error" role="alert" hidden></p>
  </ucro-video-carousel>
  <script src="{{ 'ucro-core.js' | asset_url }}" defer></script>
  <script src="{{ 'ucro-carousel.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <div class="ucro-note" {{ block.shopify_attributes }}>
    {%- if enabled == false -%}
      Video carousel is switched off in CRO Toolbox.
    {%- elsif slides.size == 0 or slides == blank -%}
      Video carousel: add videos in CRO Toolbox → Video carousel. Only you see this note.
    {%- else -%}
      Video carousel: hidden on this page by its "Where it shows" settings in CRO Toolbox. Only you see this note.
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Video carousel",
  "target": "section",
  "stylesheet": "ucro.css",
  "enabled_on": { "templates": ["*"], "groups": ["*"] },
  "settings": [
    { "type": "paragraph", "content": "Videos, their order and linked products, the look and the pages it shows on are all set in CRO Toolbox → Video carousel." }
  ]
}
{% endschema %}
