{%- comment -%}
  App block: collection pills — a row of buttons to other collections; the one being viewed is
  highlighted. Set in the app (Sections → Collection pills); ucs-collection-pills.js builds it.
{%- endcomment -%}
{%- capture dk -%}{%- render 'ucs-dk', key: 'collection_pills', pick: block.settings.design -%}{%- endcapture -%}
{%- assign dkd = dk | append: '_draft' -%}
{%- assign c = shop.metaobjects['$app:cro_design'][dk].config.value -%}
{%- if request.design_mode and shop.metaobjects['$app:cro_design'][dkd].config.value -%}{%- assign c = shop.metaobjects['$app:cro_design'][dkd].config.value -%}{%- endif -%}
{%- if c.i.size > 0 -%}
  <div class="ucs ucs-cp" data-ucs-cp data-root="{{ routes.collections_url }}" data-on="{{ collection.handle }}" {{ block.shopify_attributes }}><script type="application/json">{{ c | json }}</script></div>
  <script src="{{ 'ucs-collection-pills.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <p class="ucs-note">{{ 'ucs.cp_empty' | t }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Collection pills",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "select", "id": "design", "label": "Style", "default": "1", "info": "Which of the styles made in the app to show.", "options": [
      { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }
    ] },
    { "type": "paragraph", "content": "Collections, order, colours and sizes are set in the app: Storefront → Collection pills." }
  ]
}
{% endschema %}
