{%- comment -%}
  App block: hero banner with separate desktop and mobile images (served with <picture>, so each
  device downloads only its own image), overlay, text, up to two buttons and a whole-image link.
  Banners are made in the app (Hero banners); this block picks one, or shows the first banner.
  The picker's metaobject_type must be the resolved type (Shopify rejects "$app:" there):
  app--<this app's numeric id>--cro_hero. If the app is ever re-created, update the id.
{%- endcomment -%}
{%- liquid
  assign hero = block.settings.banner
  if hero == blank
    assign first = shop.metaobjects['$app:cro_design']['hero_default'].config.value
    if first.h
      assign hero = shop.metaobjects['$app:cro_hero'][first.h]
    endif
  endif
  assign c = hero.config.value
  assign img_d = hero.image_desktop.value
  assign img_m_own = hero.image_mobile.value
  if request.design_mode and hero.draft.value
    assign c = hero.draft.value
    assign img_d = hero.draft_desktop.value
    assign img_m_own = hero.draft_mobile.value
  endif
  assign img_m = img_m_own | default: img_d
  # A fixed height must not also follow the image's shape, or the banner grows wider than the page.
  assign ar_d = 'auto'
  if c.ad
    assign ar_d = img_d.aspect_ratio | default: 2.4
  endif
  assign ar_m = 'auto'
  if c.am
    assign ar_m = img_m.aspect_ratio | default: 0.8
  endif
  assign fp_d = img_d.presentation.focal_point | default: 'center'
  assign fp_m = img_m.presentation.focal_point | default: 'center'
  assign loading = 'eager'
  assign priority = 'high'
  if block.settings.place == 'lower'
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
  assign has_buttons = false
  if c.b1 != blank or c.b2 != blank
    assign has_buttons = true
  endif
-%}
{%- if c -%}
<div
  class="ucs ucs-hero{{ c.cls }}"
  style="{{ c.css }} --ucs-hero-ard: {{ ar_d }}; --ucs-hero-arm: {{ ar_m }}; --ucs-hero-fpd: {{ fp_d }}; --ucs-hero-fpm: {{ fp_m }};"
  {{ block.shopify_attributes }}
>
  <div class="ucs-hero__frame">
    <picture class="ucs-hero__media">
      {%- if img_d != blank -%}
        {%- if img_m_own != blank -%}
          <source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 500 }} 500w, {{ img_m | image_url: width: 750 }} 750w, {{ img_m | image_url: width: 1100 }} 1100w, {{ img_m | image_url: width: 1500 }} 1500w" sizes="100vw" width="{{ img_m.width }}" height="{{ img_m.height }}">
        {%- endif -%}
        {{ img_d | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2500, 3000', sizes: '100vw', loading: loading, fetchpriority: priority, class: 'ucs-hero__img', alt: img_d.alt }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'ucs-hero__img ucs-hero__ph' }}
      {%- endif -%}
    </picture>
    <div class="ucs-hero__overlay" aria-hidden="true"></div>
    {%- if c.ln != blank -%}
      <a class="ucs-hero__link" href="{{ c.ln | escape }}" aria-label="{{ c.h | default: shop.name | escape }}"></a>
    {%- endif -%}
    {%- if c.h != blank or c.t != blank or has_buttons -%}
      <div class="ucs-hero__content">
        <div class="ucs-hero__inner">
          {%- if c.h != blank %}<h2 class="ucs-hero__title">{{ c.h | escape }}</h2>{% endif -%}
          {%- if c.t != blank %}<div class="ucs-hero__text"><p>{{ c.t | escape | newline_to_br }}</p></div>{% endif -%}
          {%- if has_buttons -%}
            <div class="ucs-hero__buttons">
              {%- if c.b1 != blank %}<a class="ucs-btn" href="{{ c.l1 | default: routes.all_products_collection_url | escape }}">{{ c.b1 | escape }}</a>{% endif -%}
              {%- if c.b2 != blank %}<a class="ucs-btn ucs-btn--outline" href="{{ c.l2 | default: routes.root_url | escape }}">{{ c.b2 | escape }}</a>{% endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- elsif request.design_mode -%}
  <p class="ucs-note" {{ block.shopify_attributes }}>Hero image: make a banner in CRO Toolbox → Sections → Hero banners, then pick it here. Only you see this note.</p>
{%- endif -%}

{% schema %}
{
  "name": "Hero image",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "paragraph", "content": "Images, text and look are set in the app: CRO Toolbox → Sections → Hero banners." },
    { "type": "metaobject", "id": "banner", "label": "Banner", "metaobject_type": "app--427692097537--cro_hero", "info": "Empty = your first banner." },
    { "type": "select", "id": "place", "label": "Where on the page", "default": "top", "options": [{ "value": "top", "label": "At the top (load right away)" }, { "value": "lower", "label": "Lower down (load when scrolled to)" }] }
  ]
}
{% endschema %}
