{%- liquid
  assign cfg = shop.metaobjects['$app:cro_settings']['settings']
  assign enabled = true
  if cfg and cfg.cross_sell_enabled.value == false
    assign enabled = false
  endif

  assign placement = 'product'
  if template.name == 'cart'
    assign placement = 'cart'
  endif

  assign rule_handle = ''
  if enabled
    capture rule_handle
      render 'ucro-match', kind: 'cross_sell', placement: placement, product: product
    endcapture
    assign rule_handle = rule_handle | split: '@@'
    assign rule_handle = rule_handle[1] | strip
  endif

  # An A/B test on this offer (Pro): both versions are rendered, ucro-ab keeps the shopper's own.
  assign ab_test = nil
  if rule_handle != blank and request.design_mode == false
    assign ab_test = shop.metaobjects['$app:cro_design']['ab_tests'].config.value[rule_handle]
  endif
-%}
{%- if ab_test -%}
  {%- render 'ucro-cross-sell-body', block: block, product: product, cart: cart, enabled: enabled, placement: placement, rule_handle: rule_handle, ab: 'A', ab_test: ab_test, scripts: false -%}
  {%- render 'ucro-cross-sell-body', block: block, product: product, cart: cart, enabled: enabled, placement: placement, rule_handle: rule_handle, ab: 'B', ab_test: ab_test, scripts: true -%}
  {%- render 'ucro-ab', test: ab_test -%}
{%- else -%}
  {%- render 'ucro-cross-sell-body', block: block, product: product, cart: cart, enabled: enabled, placement: placement, rule_handle: rule_handle, ab: '', ab_test: nil, scripts: true -%}
{%- endif -%}

{% schema %}
{
  "name": "Cross-sell offers",
  "target": "section",
  "stylesheet": "ucro.css",
  "enabled_on": { "templates": ["product", "cart"] },
  "settings": [
    { "type": "select", "id": "design", "label": "Style", "default": "1", "info": "Which of the styles made in the app to show.", "options": [
      { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }
    ] },
    { "type": "paragraph", "content": "Products, headline and discount come from your Cross-sell rules; the look is set in CRO Toolbox → Cross-sell offers → Design." }
  ]
}
{% endschema %}
