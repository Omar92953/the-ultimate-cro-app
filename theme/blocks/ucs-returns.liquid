{%- comment -%}
  App block: Returns page. Shoppers find their order with its number and email, choose items and a reason; requests arrive in the app (Returns).
  Words and look are designed in the app (Header & pages → Returns, $app:cro_design "returns_page"); ucs-orders.js does the rest.
{%- endcomment -%}
{%- capture dk -%}{%- render 'ucs-dk', key: 'returns_page', pick: block.settings.design -%}{%- endcapture -%}
{%- assign dkd = dk | append: '_draft' -%}
{%- liquid
  assign d = shop.metaobjects['$app:cro_design'][dk].config.value
  if request.design_mode and shop.metaobjects['$app:cro_design'][dkd].config.value
    assign d = shop.metaobjects['$app:cro_design'][dkd].config.value
  endif
-%}
<div class="{{ d.cls | default: 'ucs ucs-op ucs-op--center' }}" style="{{ d.css }}" data-ucs-orders="returns" data-root="{{ routes.root_url }}" data-locale="{{ request.locale.iso_code }}" {{ block.shopify_attributes }}>
  <script type="application/json">{{ d | json | default: 'null' }}</script>
  <noscript><p class="ucs-op__t">Please turn on JavaScript to use this page.</p></noscript>
</div>
<script src="{{ 'ucs-orders.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Returns",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "select", "id": "design", "label": "Design", "default": "1", "info": "Which of the designs made in the app to show.", "options": [
      { "value": "1", "label": "Design 1" }, { "value": "2", "label": "Design 2" }, { "value": "3", "label": "Design 3" }, { "value": "4", "label": "Design 4" }, { "value": "5", "label": "Design 5" }
    ] },
    { "type": "paragraph", "content": "Add it to a page (e.g. a page called Returns). Words and look are set in the app: Header & pages → Returns." }
  ]
}
{% endschema %}
