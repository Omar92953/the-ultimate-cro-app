{%- liquid
  assign cfg = shop.metaobjects['$app:cro_settings']['settings']
  assign enabled = true
  if cfg and cfg.upsell_enabled.value == false
    assign enabled = false
  endif

  assign rule = nil
  if enabled and product != blank
    capture rule_handle
      render 'ucro-match', kind: 'upsell', placement: 'product', product: product
    endcapture
    assign rule_handle = rule_handle | split: '@@'
    assign rule_handle = rule_handle[1] | strip
    if rule_handle != blank
      assign rule = shop.metaobjects['$app:cro_rule'][rule_handle]
    endif
  endif

  assign tiers = nil
  if rule
    assign tiers = rule.tiers.value
  endif
  assign sv = product.selected_or_first_available_variant

  # "quantity" = Buy 1/2/3; "variant" = tiers are values of one option (e.g. Size)
  assign utype = 'quantity'
  if rule and rule.upsell_type.value == 'variant'
    assign utype = 'variant'
  endif

  assign opt_pos = 0
  if utype == 'variant'
    assign want = rule.option_name.value | downcase | strip
    for o in product.options_with_values
      assign oname = o.name | downcase | strip
      if oname == want
        assign opt_pos = forloop.index
        break
      endif
    endfor
  endif
  assign opt_i = opt_pos | minus: 1

  assign per_item = false
  if utype == 'quantity' and block.settings.per_item and product.has_only_default_variant == false
    assign per_item = true
  endif

  assign renderable = false
  if tiers != blank and tiers.size > 0 and product.available
    if utype == 'quantity' or opt_pos > 0
      assign renderable = true
    endif
  endif
  assign list = false
  if block.settings.style == 'list'
    assign list = true
  endif
-%}

{%- if renderable -%}
  <ucro-upsell
    class="ucro ucro-upsell{% if list %} ucro-upsell--list{% endif %}{% if block.settings.devices == 'mobile' %} ucro-hide-desktop{% elsif block.settings.devices == 'desktop' %} ucro-hide-mobile{% endif %}"
    style="--ucro-align: {{ block.settings.text_align }}; --ucro-gap: {{ block.settings.gap }}px; --ucro-pt: {{ block.settings.padding_top }}px; --ucro-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.accent != blank %} --ucro-accent: {{ block.settings.accent }};{% endif %}{% if block.settings.border_color != blank %} --ucro-border: {{ block.settings.border_color }};{% endif %}{% if block.settings.badge_bg != blank %} --ucro-badge-bg: {{ block.settings.badge_bg }};{% endif %}{% if block.settings.badge_text != blank %} --ucro-badge-fg: {{ block.settings.badge_text }};{% endif %}{% if block.settings.save_bg != blank %} --ucro-save-bg: {{ block.settings.save_bg }};{% endif %}{% if block.settings.save_text != blank %} --ucro-save-fg: {{ block.settings.save_text }};{% endif %}{% unless block.settings.theme_radius %} --ucro-radius: {{ block.settings.radius }}px;{% endunless %}"
    data-radius="{% if block.settings.theme_radius %}theme{% else %}custom{% endif %}"
    data-type="{{ utype }}"
    data-variant-id="{{ sv.id }}"
    data-own-button="{{ block.settings.own_button }}"
    data-per-item="{{ per_item }}"
    data-item-label="{{ block.settings.item_label | escape }}"
    data-error="{{ 'ucro.error' | t | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- if rule.headline.value != blank -%}
      <h2 class="ucro__heading ucro__heading--{{ block.settings.heading_size }}{% if block.settings.heading_style == 'label' %} ucro__heading--label{% endif %}">{{ rule.headline.value | escape }}</h2>
    {%- endif -%}
    {%- if rule.subheadline.value != blank -%}
      <p class="ucro__sub">{{ rule.subheadline.value | escape }}</p>
    {%- endif -%}

    <div class="ucro-tiers" role="radiogroup" aria-label="{{ rule.headline.value | default: rule.name.value | escape }}">
      {%- for tier in tiers -%}
        {%- liquid
          assign pct = tier.pct | default: 0
          assign keep = 100 | minus: pct
          assign qty = 1
          assign tvar = sv
          assign tval = ''
          if utype == 'variant'
            # The variant with this option value, keeping the shopper's other choices (e.g. colour).
            assign tval = tier.value | downcase | strip
            assign tvar = nil
            assign fallback = nil
            for v in product.variants
              assign vv = v.options[opt_i] | downcase | strip
              if vv != tval
                continue
              endif
              if fallback == nil
                assign fallback = v
              endif
              assign same = true
              for ov in v.options
                if forloop.index0 != opt_i and ov != sv.options[forloop.index0]
                  assign same = false
                endif
              endfor
              if same
                assign tvar = v
                break
              endif
            endfor
            if tvar == nil
              assign tvar = fallback
            endif
          else
            assign qty = tier.qty | default: 1
          endif
        -%}
        {%- if tvar == nil -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign was = tvar.price | times: qty
          assign total = was | times: keep | divided_by: 100.0 | round
          assign label = tier.label
          if label == blank
            if utype == 'variant'
              assign label = tier.value
            else
              assign label = block.settings.label_pattern | default: 'Buy [quantity]' | replace: '[quantity]', qty
            endif
          endif
          assign show_save = false
          if pct > 0 and block.settings.show_saving
            assign show_save = true
          endif
          assign save_text = block.settings.saving_text | replace: '[percent]', pct
        -%}
        <div class="ucro-tier-wrap">
          <button
            type="button"
            class="ucro-tier"
            role="radio"
            aria-checked="false"
            data-index="{{ forloop.index0 }}"
            data-qty="{{ qty }}"
            {% if utype == 'variant' %}data-value="{{ tier.value | escape }}" data-variant="{{ tvar.id }}"{% endif %}
            {% unless tvar.available %}disabled{% endunless %}
          >
            <span class="ucro-tier__radio" aria-hidden="true"></span>
            {%- if list -%}
              <span class="ucro-tier__main">
                <span class="ucro-tier__line">
                  <span class="ucro-tier__label">{{ label | escape }}</span>
                  {%- if tier.badge != blank -%}<span class="ucro-tier__badge">{{ tier.badge | escape }}</span>{%- endif -%}
                </span>
                {%- if show_save -%}<span class="ucro-tier__save-text">{{ save_text }}</span>{%- endif -%}
              </span>
              <span class="ucro-tier__price ucro-tier__price--stack">
                <s class="ucro-was"{% if pct == 0 %} hidden{% endif %}>{{ was | money }}</s>
                <strong class="ucro-tier__total" data-ucro-price>{{ total | money }}</strong>
              </span>
            {%- else -%}
              <span class="ucro-tier__label">{{ label | escape }}</span>
              <span class="ucro-tier__price">
                <s class="ucro-was"{% if pct == 0 %} hidden{% endif %}>{{ was | money }}</s>
                <strong class="ucro-tier__total" data-ucro-price>{{ total | money }}</strong>
              </span>
            {%- endif -%}
          </button>
          {%- unless list -%}
            {%- if show_save or tier.badge != blank -%}
              <span class="ucro-tier__tags">
                {%- if show_save -%}<span class="ucro-tier__save">{{ save_text }}</span>{%- endif -%}
                {%- if tier.badge != blank -%}<span class="ucro-tier__badge">{{ tier.badge | escape }}</span>{%- endif -%}
              </span>
            {%- endif -%}
          {%- endunless -%}
          {%- if per_item and qty > 1 -%}
            <div class="ucro-tier__items" hidden></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <button type="button" class="ucro-btn ucro-upsell__add" hidden>{{ block.settings.button_label | escape }}</button>
    <p class="ucro__error" role="alert" hidden></p>

    {%- comment -%} Prices formatted by Shopify, so the script never formats money itself. {%- endcomment -%}
    <script type="application/json" data-ucro-prices>
      {
        "type": {{ utype | json }},
        {%- if utype == 'variant' -%}
          {%- comment -%} Every variant whose option value has a tier: its tier, prices and the "other options" key. {%- endcomment -%}
          "vs": [
            {%- assign first_v = true -%}
            {%- for v in product.variants -%}
              {%- liquid
                assign vv = v.options[opt_i] | downcase | strip
                assign vt = nil
                assign vt_index = 0
                for tier in tiers
                  assign tv = tier.value | downcase | strip
                  if tv == vv
                    assign vt = tier
                    assign vt_index = forloop.index0
                    break
                  endif
                endfor
              -%}
              {%- if vt == nil -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign key = ''
                for ov in v.options
                  if forloop.index0 != opt_i
                    assign key = key | append: ov | append: '|'
                  endif
                endfor
                assign v_pct = vt.pct | default: 0
                assign v_keep = 100 | minus: v_pct
                assign v_total = v.price | times: v_keep | divided_by: 100.0 | round
              -%}
              {%- unless first_v -%},{%- endunless -%}{%- assign first_v = false -%}
              { "id": {{ v.id }}, "k": {{ key | downcase | json }}, "t": {{ vt_index }}, "av": {{ v.available | json }}, "was": {{ v.price | money | json }}, "total": {{ v_total | money | json }} }
            {%- endfor -%}
          ]
        {%- else -%}
          "q": {
            {%- for variant in product.variants -%}
              "{{ variant.id }}": {
                "av": {{ variant.available | json }},
                "t": [
                  {%- for tier in tiers -%}
                    {%- liquid
                      assign v_qty = tier.qty | default: 1
                      assign v_pct = tier.pct | default: 0
                      assign v_keep = 100 | minus: v_pct
                      assign v_was = variant.price | times: v_qty
                      assign v_total = v_was | times: v_keep | divided_by: 100.0 | round
                    -%}
                    { "was": {{ v_was | money | json }}, "total": {{ v_total | money | json }} }
                    {%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              }
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          }
          {%- if per_item -%}
            ,"items": [
              {%- assign first_i = true -%}
              {%- for variant in product.variants -%}
                {%- unless variant.available -%}{%- continue -%}{%- endunless -%}
                {%- unless first_i -%},{%- endunless -%}{%- assign first_i = false -%}
                { "id": {{ variant.id }}, "t": {{ variant.title | json }} }
              {%- endfor -%}
            ]
          {%- endif -%}
        {%- endif -%}
      }
    </script>
  </ucro-upsell>
  <script src="{{ 'ucro-core.js' | asset_url }}" defer></script>
  <script src="{{ 'ucro-offers.js' | asset_url }}" defer></script>
{%- elsif request.design_mode -%}
  <div class="ucro-note" {{ block.shopify_attributes }}>
    {%- if enabled == false -%}
      Upsell is switched off in CRO Toolbox.
    {%- elsif product == blank -%}
      Upsell only works on product pages.
    {%- elsif product.available == false -%}
      Upsell is hidden because this product is sold out.
    {%- elsif rule and utype == 'variant' and opt_pos == 0 -%}
      Upsell: rule “{{ rule.name.value | escape }}” offers {{ rule.option_name.value | escape }} tiers, but this product has no “{{ rule.option_name.value | escape }}” option. Only you see this note.
    {%- else -%}
      Upsell: no rule matches this product yet. Add one in CRO Toolbox. Only you see this note.
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Upsell offers",
  "target": "section",
  "stylesheet": "ucro.css",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Offers, prices and discounts come from your Upsell rules in CRO Toolbox. Discounts apply at checkout automatically."
    },
    {
      "type": "header",
      "content": "Offers"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "cards",
      "options": [
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "list",
          "label": "Grouped list"
        }
      ],
      "info": "Cards: one box per offer. Grouped list: one box with a row per offer."
    },
    {
      "type": "text",
      "id": "label_pattern",
      "label": "Offer name",
      "default": "Buy [quantity]",
      "info": "[quantity] becomes the number, e.g. Buy 2."
    },
    {
      "type": "checkbox",
      "id": "show_saving",
      "label": "Show the saving",
      "default": true
    },
    {
      "type": "text",
      "id": "saving_text",
      "label": "Saving text",
      "default": "Save [percent]%",
      "info": "[percent] becomes the discount, e.g. Save 10%.",
      "visible_if": "{{ block.settings.show_saving }}"
    },
    {
      "type": "checkbox",
      "id": "per_item",
      "label": "Let shoppers pick a size for each item",
      "default": true,
      "info": "For products with sizes: choosing Buy 2 shows two size pickers."
    },
    {
      "type": "text",
      "id": "item_label",
      "label": "Item picker label",
      "default": "#[n]",
      "info": "[n] becomes the item number.",
      "visible_if": "{{ block.settings.per_item }}"
    },
    {
      "type": "checkbox",
      "id": "own_button",
      "label": "Show a separate Add to cart button",
      "default": false,
      "info": "Off: shoppers use your theme's normal Add to cart button."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to cart",
      "visible_if": "{{ block.settings.own_button }}"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Style",
      "default": "heading",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "label",
          "label": "Small caps label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "visible_if": "{{ block.settings.heading_style == 'heading' }}"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Selected offer",
      "info": "Leave any color empty to use your theme's colors."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Offer border"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "info": "The badge set on a tier in the app, e.g. Most popular."
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text"
    },
    {
      "type": "color",
      "id": "save_bg",
      "label": "Saving tag background",
      "visible_if": "{{ block.settings.style == 'cards' }}"
    },
    {
      "type": "color",
      "id": "save_text",
      "label": "Saving text"
    },
    {
      "type": "header",
      "content": "Corners and spacing"
    },
    {
      "type": "checkbox",
      "id": "theme_radius",
      "label": "Match my theme's corners",
      "default": true
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.theme_radius == false }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between offers",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.style == 'cards' }}"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "select",
      "id": "devices",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Desktop and mobile"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        }
      ]
    }
  ]
}
{% endschema %}
