{%- liquid
  assign cfg = shop.metaobjects['$app:cro_settings']['settings']
  assign enabled = true
  if cfg and cfg.upsell_enabled.value == false
    assign enabled = false
  endif

  assign rule_handle = ''
  if enabled and product != blank
    capture rule_handle
      render 'ucro-match', kind: 'upsell', placement: 'product', product: product
    endcapture
    assign rule_handle = rule_handle | split: '@@'
    assign rule_handle = rule_handle[1] | strip
  endif

  # An A/B test on this offer (Pro): both versions are rendered, ucro-ab keeps the shopper's own.
  assign ab_test = nil
  if rule_handle != blank and request.design_mode == false
    assign ab_test = shop.metaobjects['$app:cro_design']['ab_tests'].config.value[rule_handle]
  endif
-%}
{%- if ab_test -%}
  {%- render 'ucro-upsell-body', block: block, product: product, enabled: enabled, rule_handle: rule_handle, ab: 'A', ab_test: ab_test, scripts: false -%}
  {%- render 'ucro-upsell-body', block: block, product: product, enabled: enabled, rule_handle: rule_handle, ab: 'B', ab_test: ab_test, scripts: true -%}
  {%- render 'ucro-ab', test: ab_test -%}
{%- else -%}
  {%- render 'ucro-upsell-body', block: block, product: product, enabled: enabled, rule_handle: rule_handle, ab: '', ab_test: nil, scripts: true -%}
{%- endif -%}

{% schema %}
{
  "name": "Upsell offers",
  "target": "section",
  "stylesheet": "ucro.css",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "select", "id": "design", "label": "Style", "default": "1", "info": "Which of the styles made in the app to show.", "options": [
      { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }
    ] },
    { "type": "paragraph", "content": "Offers come from your Upsell rules in CRO Toolbox; their look and wording are set in the app: Offers → Upsell → Design." }
  ]
}
{% endschema %}
