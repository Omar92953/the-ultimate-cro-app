{%- comment -%}
  App embed: conversion boosters — sticky add to cart, stock urgency, trust badges and sales
  pop-ups. Everything is edited in the app (Boosters page) and drawn by ucs-boosters.js; this
  only hands over the settings, the product's stock and the shop's payment icons.
{%- endcomment -%}
{%- liquid
  assign cfg = shop.metaobjects['$app:cro_boosters']['main'].config.value
  assign recent = shop.metaobjects['$app:cro_recent']['main'].purchases.value
  comment
    Stock goes into the page only for stock urgency, capped just above its threshold, so exact
    inventory isn't published.
  endcomment
  assign urg = true
  if cfg.urgency.enabled == false
    assign urg = false
  endif
  assign cap = cfg.urgency.threshold | default: 10 | plus: 1
-%}
<script type="application/json" id="ucs-boost" {{ block.shopify_attributes }}>
  {
    "cfg": {{ cfg | json }},
    "recent": {{ recent | json }},
    "fmt": {{ shop.money_format | json }},
    "page": {{ request.page_type | json }},
    "offers": {{ shop.metaobjects['$app:cro_offers']['main'].data.value | json | default: 'null' }},
    "t": { "close": {{ 'ucs.close' | t | json }}, "in": {{ 'ucs.pop_in' | t | json }} }
    {%- if product -%}
      ,"product": {
        "handle": {{ product.handle | json }},
        "id": {{ product.id }},
        "cols": [{% for c in product.collections %}{{ c.id }},{% endfor %}0],
        "stock": {
          {%- for v in product.variants -%}
            {%- if urg and v.inventory_management == 'shopify' and v.inventory_policy == 'deny' -%}"{{ v.id }}": {% if v.inventory_quantity > cap %}{{ cap }}{% else %}{{ v.inventory_quantity }}{% endif %},{%- endif -%}
          {%- endfor -%}
          "_": 0
        }
      }
    {%- endif %}
  }
</script>
<template id="ucs-pay">
  {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'ucs-pay' }}{%- endfor -%}
</template>
<script src="{{ 'ucs-boosters.js' | asset_url }}" defer></script>
{%- if shop.metaobjects['$app:cro_offers']['main'].data.value.deals.size > 0 %}<script src="{{ 'ucs-deals.js' | asset_url }}" defer></script>{% endif %}

{%- comment -%} Free shipping bar copies inside the cart drawer and the cart page, so they work even when the bar block isn't placed. {%- endcomment -%}
{%- assign fsb = shop.metaobjects['$app:cro_design']['shipping_bar'].config.value -%}
{%- if request.design_mode and shop.metaobjects['$app:cro_design']['shipping_bar_draft'].config.value -%}{%- assign fsb = shop.metaobjects['$app:cro_design']['shipping_bar_draft'].config.value -%}{%- endif -%}
{%- if fsb.on -%}{%- if fsb.s.drawer or fsb.s.cartPage -%}
  <div data-ucs-fsb data-cart-only data-total="{{ cart.total_price }}" data-page="{{ request.page_type }}" hidden><script type="application/json">{{ fsb | json }}</script></div>
  <link rel="stylesheet" href="{{ 'ucs-shipping-bar.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'ucs-shipping-bar.js' | asset_url }}" defer></script>
{%- endif -%}{%- endif %}

{% schema %}
{
  "name": "Conversion boosters",
  "target": "body",
  "stylesheet": "ucs-boosters.css",
  "settings": [
    { "type": "paragraph", "content": "Sticky add to cart, stock urgency, trust badges, sales pop-ups and bundle deals. Edit them in the app: Boosters and Bundles." }
  ]
}
{% endschema %}
