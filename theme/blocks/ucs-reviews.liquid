{%- comment -%}
  App block: customer reviews. The reviews come from the app (Sections → Customer reviews) and the
  design from the app (Sections → Customer reviews → Design). This only picks the reviews for
  the page (a product's own reviews on its page, if the design asks for that) and passes them to
  ucs-reviews.js, which builds the section.
{%- endcomment -%}
{%- capture dk -%}{%- render 'ucs-dk', key: 'reviews', pick: block.settings.design -%}{%- endcapture -%}
{%- render 'ucs-reviews-body', key: dk, attrs: block.shopify_attributes, product: product -%}

{% schema %}
{
  "name": "Customer reviews",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "select", "id": "design", "label": "Style", "default": "1", "info": "Which of the styles made in the app to show.", "options": [
      { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }
    ] },
    { "type": "paragraph", "content": "Reviews and how they look are set in the app: Section library → Customer reviews." }
  ]
}
{% endschema %}
