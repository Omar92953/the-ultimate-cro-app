{%- comment -%}
  App block: FAQ accordion (native <details>, works without JavaScript) with optional search,
  group tabs and FAQPage structured data for Google. Questions come from the app (Store sections → FAQ).
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign only_group = s.group | strip | downcase
  # Shown questions in the app's order; "sel" lists the handles this block shows.
  assign items = shop.metaobjects['$app:cro_lists']['main'].faq.value
  assign sel = ','
  assign groups = ''
  for m in items
    if m.question.value == blank
      continue
    endif
    assign g = m.group.value | strip
    if only_group != blank
      assign g_lower = g | downcase
      if g_lower != only_group
        continue
      endif
    endif
    if g != blank
      assign groups = groups | append: g | append: '|'
    endif
    assign sel = sel | append: m.system.handle | append: ','
  endfor
  assign count = 0
  if sel != ','
    assign count = 1
  endif
  assign groups = groups | split: '|' | uniq
  assign show_tabs = false
  if s.group_tabs and only_group == blank and groups.size > 1
    assign show_tabs = true
  endif
  assign on_accent = '#ffffff'
  if s.accent != blank
    assign brightness = s.accent | color_brightness
    if brightness > 150
      assign on_accent = '#121212'
    endif
  endif
  assign exclusive = ''
  if s.one_open
    assign exclusive = 'ucs-faq-' | append: block.id
  endif
-%}
<div
  class="ucs ucs-faq ucs-faq--{{ s.style }} ucs-faq--{{ s.icon }}{% if s.devices == 'mobile' %} ucs-hide-desktop{% elsif s.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
  style="--ucs-pt: {{ s.padding_top }}px; --ucs-pb: {{ s.padding_bottom }}px; --ucs-h: {{ s.heading_size }}px; --ucs-align: {{ s.align }}; --ucs-max: {{ s.max_width }}px; --ucs-faq-q: {{ s.question_size }}px; --ucs-faq-radius: {{ s.radius }}px;{% if s.bg != blank %} background: {{ s.bg }};{% endif %}{% if s.card_bg != blank %} --ucs-faq-card: {{ s.card_bg }};{% endif %}{% if s.accent != blank %} --ucs-accent: {{ s.accent }}; --ucs-on-accent: {{ on_accent }};{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="ucs-wrap">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="ucs-head">
        {%- if s.heading != blank %}<h2>{{ s.heading | escape }}</h2>{% endif -%}
        {%- if s.subheading != blank %}<p>{{ s.subheading | escape }}</p>{% endif -%}
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      {%- if s.search or show_tabs -%}
        <div class="ucs-faq__tools">
          {%- if s.search -%}
            <label class="ucs-faq__search">
              <span class="ucs-i ucs-i--search" aria-hidden="true"></span>
              <input type="search" placeholder="{{ 'ucs.faq_search' | t | escape }}" aria-label="{{ 'ucs.faq_search' | t | escape }}" autocomplete="off">
            </label>
          {%- endif -%}
          {%- if show_tabs -%}
            <div class="ucs-faq__tabs" role="group">
              <button type="button" class="ucs-faq__tab" data-group="" aria-pressed="true">{{ 'ucs.faq_all' | t }}</button>
              {%- for g in groups -%}
                <button type="button" class="ucs-faq__tab" data-group="{{ g | handleize }}" aria-pressed="false">{{ g | escape }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ucs-faq__list ucs-faq__list--{{ s.columns }}">
        {%- assign n = 0 -%}
        {%- for m in items -%}
          {%- assign key = ',' | append: m.system.handle | append: ',' -%}
          {%- unless sel contains key %}{% continue %}{% endunless -%}
          {%- assign n = n | plus: 1 -%}
          <details class="ucs-faq__item" data-group="{{ m.group.value | strip | handleize }}"{% if exclusive != blank %} name="{{ exclusive }}"{% endif %}{% if s.open_first and n == 1 %} open{% endif %}>
            <summary class="ucs-faq__q"><span>{{ m.question.value | escape }}</span><span class="ucs-faq__icon" aria-hidden="true"></span></summary>
            <div class="ucs-faq__a">{{ m.answer.value | escape | newline_to_br }}</div>
          </details>
        {%- endfor -%}
        <p class="ucs-faq__none" hidden>{{ 'ucs.faq_none' | t }}</p>
      </div>

      {%- if s.schema -%}
        {%- capture entries -%}
          {%- for m in items -%}
            {%- assign key = ',' | append: m.system.handle | append: ',' -%}
            {%- unless sel contains key %}{% continue %}{% endunless -%}
            ,{"@type":"Question","name":{{ m.question.value | json }},"acceptedAnswer":{"@type":"Answer","text":{{ m.answer.value | default: '' | json }}}}
          {%- endfor -%}
        {%- endcapture -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ entries | strip | remove_first: ',' }}]}</script>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="ucs-note">{{ 'ucs.faq_empty' | t }}</p>
    {%- endif -%}

    {%- if s.contact_label != blank -%}
      <div class="ucs-faq__help">
        {%- if s.contact_text != blank %}<p>{{ s.contact_text | escape }}</p>{% endif -%}
        <a class="ucs-btn" href="{{ s.contact_link | default: '/pages/contact' }}">{{ s.contact_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>
{%- if s.search or show_tabs or exclusive != blank -%}
  <script src="{{ 'ucs-faq.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "paragraph", "content": "Add, group and order questions in the app: Store sections → FAQ." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "subheading", "label": "Text under the heading" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "header", "content": "Questions" },
    { "type": "text", "id": "group", "label": "Only this group", "info": "Optional, e.g. Shipping. Empty = all questions." },
    { "type": "checkbox", "id": "group_tabs", "label": "Show group buttons (All, Shipping, Returns…)", "default": true },
    { "type": "checkbox", "id": "search", "label": "Show a search box", "default": true },
    { "type": "checkbox", "id": "one_open", "label": "Open one answer at a time", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": false },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "1", "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }] },
    { "type": "header", "content": "Look" },
    { "type": "select", "id": "style", "label": "Style", "default": "lines", "options": [{ "value": "lines", "label": "Lines between questions" }, { "value": "cards", "label": "Cards" }] },
    { "type": "select", "id": "icon", "label": "Icon", "default": "plus", "options": [{ "value": "plus", "label": "Plus" }, { "value": "chevron", "label": "Arrow" }] },
    { "type": "range", "id": "question_size", "label": "Question size", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "max_width", "label": "Width", "min": 560, "max": 1400, "step": 20, "unit": "px", "default": 860 },
    { "type": "range", "id": "radius", "label": "Card corners", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "bg", "label": "Background", "info": "Leave empty to use your theme's." },
    { "type": "color", "id": "card_bg", "label": "Card background" },
    { "type": "color", "id": "accent", "label": "Buttons", "default": "#121212" },
    { "type": "header", "content": "Help button" },
    { "type": "text", "id": "contact_text", "label": "Text", "default": "Still have a question?" },
    { "type": "text", "id": "contact_label", "label": "Button", "default": "Contact us", "info": "Empty = no button." },
    { "type": "url", "id": "contact_link", "label": "Button link", "info": "Your contact page, or a WhatsApp link like https://wa.me/201234567890" },
    { "type": "header", "content": "More" },
    { "type": "checkbox", "id": "schema", "label": "Help Google show these questions in search", "default": true, "info": "Adds FAQ structured data. Use it on one page only." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "select", "id": "devices", "label": "Devices", "default": "all", "options": [{ "value": "all", "label": "Desktop and mobile" }, { "value": "desktop", "label": "Desktop only" }, { "value": "mobile", "label": "Mobile only" }] }
  ]
}
{% endschema %}
