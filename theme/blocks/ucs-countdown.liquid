{%- comment -%} App block: countdown timer section (sale end, per-visitor timer, or daily order cut-off). {%- endcomment -%}
<div
  class="ucs ucs-cd-host ucs-cdh ucs-cdh--{{ block.settings.layout }}{% if block.settings.devices == 'mobile' %} ucs-hide-desktop{% elsif block.settings.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
  style="--ucs-pt: {{ block.settings.padding_top }}px; --ucs-pb: {{ block.settings.padding_bottom }}px; --ucs-cd-size: {{ block.settings.digit_size }}px; --ucs-cd-radius: {{ block.settings.radius }}px;{% if block.settings.bg != blank %} --ucs-cd-bg: {{ block.settings.bg }};{% endif %}{% if block.settings.fg != blank %} --ucs-cd-fg: {{ block.settings.fg }};{% endif %} --ucs-accent: {{ block.settings.box_bg }}; --ucs-on-accent: {{ block.settings.box_fg }};"
  {{ block.shopify_attributes }}
>
  <div class="ucs-wrap ucs-cdh__wrap">
    {%- if block.settings.heading != blank or block.settings.text != blank -%}
      <div class="ucs-cdh__text">
        {%- if block.settings.heading != blank %}<h2 class="ucs-cdh__title">{{ block.settings.heading | escape }}</h2>{% endif -%}
        {%- if block.settings.text != blank %}<p class="ucs-cdh__sub">{{ block.settings.text | escape }}</p>{% endif -%}
      </div>
    {%- endif -%}
    <div class="ucs-cdh__timer">
      {%- render 'ucs-countdown-timer', s: block.settings, key: block.id -%}
      <p class="ucs-cd__end" hidden>{{ block.settings.ended_text | escape }}</p>
    </div>
    {%- if block.settings.button_label != blank -%}
      <a class="ucs-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>
<script src="{{ 'ucs-countdown.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Countdown timer",
  "target": "section",
  "stylesheet": "ucs-sections.css",
  "settings": [
    { "type": "header", "content": "Timer" },
    { "type": "select", "id": "mode", "label": "Count down to", "default": "fixed", "options": [{ "value": "fixed", "label": "A date and time" }, { "value": "evergreen", "label": "A fresh timer for each visitor" }, { "value": "daily", "label": "A cut-off time every day" }] },
    { "type": "text", "id": "end_date", "label": "Ends on", "default": "2026-12-31 23:59", "info": "Year-month-day hour:minute, in your store's time zone.", "visible_if": "{{ block.settings.mode == 'fixed' }}" },
    { "type": "range", "id": "evergreen_hours", "label": "Each visitor gets", "min": 1, "max": 72, "step": 1, "unit": "h", "default": 24, "visible_if": "{{ block.settings.mode == 'evergreen' }}" },
    { "type": "text", "id": "daily_cutoff", "label": "Cut-off time", "default": "17:00", "info": "e.g. \"Order in the next 3h 20m for same-day dispatch\".", "visible_if": "{{ block.settings.mode == 'daily' }}" },
    { "type": "select", "id": "ended", "label": "When it ends", "default": "hide", "options": [{ "value": "hide", "label": "Hide this section" }, { "value": "message", "label": "Show a message" }, { "value": "restart", "label": "Start again (visitor timer)" }] },
    { "type": "text", "id": "ended_text", "label": "Message", "default": "This offer has ended.", "visible_if": "{{ block.settings.ended == 'message' }}" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hurry — the sale ends soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "Up to 30% off. Don't miss out." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Look" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "stack", "options": [{ "value": "stack", "label": "Centred" }, { "value": "row", "label": "In one row" }] },
    { "type": "select", "id": "style", "label": "Numbers", "default": "boxes", "options": [{ "value": "boxes", "label": "In boxes" }, { "value": "plain", "label": "Plain" }] },
    { "type": "checkbox", "id": "labels", "label": "Show Days / Hours / Min / Sec", "default": true },
    { "type": "range", "id": "digit_size", "label": "Number size", "min": 18, "max": 72, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "box_bg", "label": "Boxes and button", "default": "#121212" },
    { "type": "color", "id": "box_fg", "label": "Numbers and button text", "default": "#ffffff" },
    { "type": "color", "id": "bg", "label": "Section background", "info": "Leave empty to use your theme's." },
    { "type": "color", "id": "fg", "label": "Section text" },
    { "type": "range", "id": "radius", "label": "Box corners", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "select", "id": "devices", "label": "Devices", "default": "all", "options": [{ "value": "all", "label": "Desktop and mobile" }, { "value": "desktop", "label": "Desktop only" }, { "value": "mobile", "label": "Mobile only" }] }
  ]
}
{% endschema %}
