{%- liquid
assign pct = pct | default: 0
assign keep = 100 | minus: pct
assign v = p.selected_or_first_available_variant
assign now = v.price | times: keep | divided_by: 100.0 | round
-%}<li class="ucro-offer{% unless p.available %} is-sold-out{% endunless %}">
<label class="ucro-offer__row">
<input type="checkbox" class="ucro-offer__check"{% if checked and p.available %} checked{% endif %}{% unless p.available %} disabled{% endunless %}>
<span class="ucro-offer__box" aria-hidden="true"></span>
<span class="ucro-offer__img">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '72px', alt: p.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'ucro-placeholder' }}{%- endif -%}</span>
<span class="ucro-offer__body">
<a class="ucro-offer__title" href="{{ p.url }}">{{ p.title }}</a>
<span class="ucro-offer__prices">
<span class="ucro-offer__price" data-ucro-price>{{ now | money }}</span>{%- if pct > 0 -%}<s class="ucro-was" data-ucro-was>{{ v.price | money }}</s>{%- endif -%}</span>{%- unless p.available -%}<span class="ucro-offer__soldout">{{ 'ucro.sold_out' | t }}</span>{%- endunless -%}</span>
</label>{%- if p.available != true -%}{%- elsif p.has_only_default_variant -%}<input type="hidden" class="ucro-offer__variant" value="{{ v.id }}">{%- else -%}<select class="ucro-offer__variant ucro-select" aria-label="{{ p.title | escape }}">{%- for variant in p.variants -%}{%- assign v_now = variant.price | times: keep | divided_by: 100.0 | round -%}<option value="{{ variant.id }}" data-price="{{ v_now | money | escape }}" data-was="{{ variant.price | money | escape }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{- variant.title -}}{%- unless variant.available %} ({{ 'ucro.sold_out' | t }}){% endunless -%}</option>{%- endfor -%}</select>{%- endif -%}</li>
