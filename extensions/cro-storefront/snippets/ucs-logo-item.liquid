{%- assign h2x = height | times: 2 -%}
<li class="ucs-logos__item"{% if ghost %} aria-hidden="true"{% endif %}>
{%- if m.link.value != blank %}<a href="{{ m.link.value | escape }}" target="_blank" rel="noopener"{% if ghost %} tabindex="-1"{% endif %}>{% endif -%}
{{ m.image.value | image_url: height: h2x | image_tag: height: height, alt: m.name.value, loading: 'lazy', class: 'ucs-logos__img' }}
{%- if m.link.value != blank %}</a>{% endif -%}
</li>
