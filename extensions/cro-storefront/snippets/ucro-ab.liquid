<script>(function(){var id={{ test.id | json }},n={{ test.n | default: 2 | json }},all='ABCD'.slice(0,n),key='ucs-ab-'+id,g=null;try{g=localStorage.getItem(key)}catch(e){}if(!g||g.length!==1||all.indexOf(g)<0)g=null;
var shown=g||'A',els=document.querySelectorAll('[data-ab="'+id+'"]');for(var i=0;els.length>i;i++){if(els[i].getAttribute('data-ab-g')!==shown){els[i].parentNode.removeChild(els[i])}else{els[i].hidden=false}}
if(window.__ucsHoldout)return;
var r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
function parse(v){var o={};String(v||'').split(',').forEach(function(p){var a=p.split(':');if(a[0]&&a[1]&&a[1].length===1&&'ABCD'.indexOf(a[1])>=0)o[a[0]]=a[1]});return o}
function track(){if(!g){try{localStorage.setItem(key,all.charAt(Math.floor(Math.random()*all.length)))}catch(e){}return}
fetch(r+'cart.js').then(function(x){return x.json()}).then(function(c){var o=parse((c.attributes||{})._cro_ab);if(o[id]===g)return;o[id]=g;var s=Object.keys(o).map(function(k){return k+':'+o[k]}).join(',');return fetch(r+'cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attributes:{_cro_ab:s}})})}).catch(function(){});
try{var k='ucs-abv-'+id+'-'+new Date().toISOString().slice(0,10);if(!localStorage.getItem(k)){localStorage.setItem(k,'1');fetch(r+'apps/ucro/ab',{method:'POST',keepalive:true,headers:{'Content-Type':'application/json'},body:JSON.stringify({t:id,g:g})}).catch(function(){})}}catch(e){}}
function forget(){try{for(var j=localStorage.length-1;j>=0;j--){var n=localStorage.key(j);if(n&&(n===key||n.indexOf('ucs-abv-'+id+'-')===0))localStorage.removeItem(n)}}catch(e){}}
function decide(){var p=window.Shopify&&Shopify.customerPrivacy;if(!p||!p.analyticsProcessingAllowed)return;if(p.analyticsProcessingAllowed())track();else forget()}
if(window.Shopify&&Shopify.customerPrivacy){decide()}else if(window.Shopify&&Shopify.loadFeatures){Shopify.loadFeatures([{name:'consent-tracking-api',version:'0.1'}],function(err){if(!err)decide()})}
document.addEventListener('visitorConsentCollected',decide);
})();</script>
