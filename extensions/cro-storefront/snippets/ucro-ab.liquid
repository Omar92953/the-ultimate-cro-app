<script>(function(){var id={{ test.id | json }},g;try{g=localStorage.getItem('ucs-ab-'+id);if(g!=='A'&&g!=='B'){g=Math.random()<0.5?'A':'B';localStorage.setItem('ucs-ab-'+id,g)}}catch(e){g='A'}
var els=document.querySelectorAll('[data-ab="'+id+'"]');for(var i=0;els.length>i;i++){if(els[i].getAttribute('data-ab-g')!==g){els[i].parentNode.removeChild(els[i])}else{els[i].hidden=false}}
if(window.__ucsHoldout)return;
var r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
function parse(v){var o={};String(v||'').split(',').forEach(function(p){var a=p.split(':');if(a[0]&&(a[1]==='A'||a[1]==='B'))o[a[0]]=a[1]});return o}
fetch(r+'cart.js').then(function(x){return x.json()}).then(function(c){var o=parse((c.attributes||{})._cro_ab);if(o[id]===g)return;o[id]=g;var s=Object.keys(o).map(function(k){return k+':'+o[k]}).join(',');return fetch(r+'cart/update.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({attributes:{_cro_ab:s}})})}).catch(function(){});
try{var k='ucs-abv-'+id+'-'+new Date().toISOString().slice(0,10);if(!localStorage.getItem(k)){localStorage.setItem(k,'1');fetch(r+'apps/ucro/ab',{method:'POST',keepalive:true,headers:{'Content-Type':'application/json'},body:JSON.stringify({t:id,g:g})}).catch(function(){})}}catch(e){}
})();</script>
