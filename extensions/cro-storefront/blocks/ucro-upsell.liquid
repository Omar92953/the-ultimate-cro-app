{%- liquid
assign cfg = shop.metaobjects['$app:cro_settings']['settings']
assign enabled = true
if cfg and cfg.upsell_enabled.value == false
assign enabled = false
endif
assign rule = nil
if enabled and product != blank
capture rule_handle
render 'ucro-match', kind: 'upsell', placement: 'product', product: product
endcapture
assign rule_handle = rule_handle | split: '@@'
assign rule_handle = rule_handle[1] | strip
if rule_handle != blank
assign rule = shop.metaobjects['$app:cro_rule'][rule_handle]
endif
endif
assign tiers = nil
if rule
assign tiers = rule.tiers.value
endif
assign sv = product.selected_or_first_available_variant
assign utype = 'quantity'
if rule and rule.upsell_type.value == 'variant'
assign utype = 'variant'
endif
assign opt_pos = 0
if utype == 'variant'
assign want = rule.option_name.value | downcase | strip
for o in product.options_with_values
assign oname = o.name | downcase | strip
if oname == want
assign opt_pos = forloop.index
break
endif
endfor
endif
assign opt_i = opt_pos | minus: 1
assign d = shop.metaobjects['$app:cro_design']['upsell'].config.value
if request.design_mode and shop.metaobjects['$app:cro_design']['upsell_draft'].config.value
assign d = shop.metaobjects['$app:cro_design']['upsell_draft'].config.value
endif
assign d_pi = true
assign d_ss = true
if d.pi == false
assign d_pi = false
endif
if d.ss == false
assign d_ss = false
endif
assign per_item = false
if utype == 'quantity' and d_pi and product.has_only_default_variant == false
assign per_item = true
endif
assign renderable = false
if tiers != blank and tiers.size > 0 and product.available
if utype == 'quantity' or opt_pos > 0
assign renderable = true
endif
endif
assign list = false
if d.list
assign list = true
endif
-%}{%- if renderable -%}<ucro-upsell
class="ucro ucro-upsell{% if list %} ucro-upsell--list{% endif %}{{ d.cls }}"
style="{{ d.css | default: '--ucro-gap: 12px; --ucro-pt: 12px; --ucro-pb: 12px;' }}"
data-radius="{{ d.rad | default: 'theme' }}"
data-type="{{ utype }}"
data-variant-id="{{ sv.id }}"
data-own-button="{% if d.own %}true{% else %}false{% endif %}"
data-per-item="{{ per_item }}"
data-item-label="{{ d.il | default: '#[n]' | escape }}"
data-error="{{ 'ucro.error' | t | escape }}"
{{ block.shopify_attributes }}
>{%- if rule.headline.value != blank -%}<h2 class="ucro__heading {{ d.hc | default: 'ucro__heading--medium' }}">{{ rule.headline.value | escape }}</h2>{%- endif -%}{%- if rule.subheadline.value != blank -%}<p class="ucro__sub">{{ rule.subheadline.value | escape }}</p>{%- endif -%}<div class="ucro-tiers" role="radiogroup" aria-label="{{ rule.headline.value | default: rule.name.value | escape }}">{%- for tier in tiers -%}{%- liquid
assign pct = tier.pct | default: 0
assign keep = 100 | minus: pct
assign qty = 1
assign tvar = sv
assign tval = ''
if utype == 'variant'
assign tval = tier.value | downcase | strip
assign tvar = nil
assign fallback = nil
for v in product.variants
assign vv = v.options[opt_i] | downcase | strip
if vv != tval
continue
endif
if fallback == nil
assign fallback = v
endif
assign same = true
for ov in v.options
if forloop.index0 != opt_i and ov != sv.options[forloop.index0]
assign same = false
endif
endfor
if same
assign tvar = v
break
endif
endfor
if tvar == nil
assign tvar = fallback
endif
else
assign qty = tier.qty | default: 1
endif
-%}{%- if tvar == nil -%}{%- continue -%}{%- endif -%}{%- liquid
assign was = tvar.price | times: qty
assign total = was | times: keep | divided_by: 100.0 | round
assign label = tier.label
if label == blank
if utype == 'variant'
assign label = tier.value
else
assign label = d.label | default: 'Buy [quantity]' | replace: '[quantity]', qty
endif
endif
assign show_save = false
if pct > 0 and d_ss
assign show_save = true
endif
assign save_text = d.save | default: 'Save [percent]%' | replace: '[percent]', pct
-%}<div class="ucro-tier-wrap">
<button
type="button"
class="ucro-tier"
role="radio"
aria-checked="false"
data-index="{{ forloop.index0 }}"
data-qty="{{ qty }}"
{% if utype == 'variant' %}data-value="{{ tier.value | escape }}" data-variant="{{ tvar.id }}"{% endif %}
{% unless tvar.available %}disabled{% endunless %}
>
<span class="ucro-tier__radio" aria-hidden="true"></span>{%- if list -%}<span class="ucro-tier__main">
<span class="ucro-tier__line">
<span class="ucro-tier__label">{{ label | escape }}</span>{%- if tier.badge != blank -%}<span class="ucro-tier__badge">{{ tier.badge | escape }}</span>{%- endif -%}</span>{%- if show_save -%}<span class="ucro-tier__save-text">{{ save_text }}</span>{%- endif -%}</span>
<span class="ucro-tier__price ucro-tier__price--stack">
<s class="ucro-was"{% if pct == 0 %} hidden{% endif %}>{{ was | money }}</s>
<strong class="ucro-tier__total" data-ucro-price>{{ total | money }}</strong>
</span>{%- else -%}<span class="ucro-tier__label">{{ label | escape }}</span>
<span class="ucro-tier__price">
<s class="ucro-was"{% if pct == 0 %} hidden{% endif %}>{{ was | money }}</s>
<strong class="ucro-tier__total" data-ucro-price>{{ total | money }}</strong>
</span>{%- endif -%}</button>{%- unless list -%}{%- if show_save or tier.badge != blank -%}<span class="ucro-tier__tags">{%- if show_save -%}<span class="ucro-tier__save">{{ save_text }}</span>{%- endif -%}{%- if tier.badge != blank -%}<span class="ucro-tier__badge">{{ tier.badge | escape }}</span>{%- endif -%}</span>{%- endif -%}{%- endunless -%}{%- if per_item and qty > 1 -%}<div class="ucro-tier__items" hidden></div>{%- endif -%}</div>{%- endfor -%}</div>
<button type="button" class="ucro-btn ucro-upsell__add" hidden>{{ d.btn | default: 'Add to cart' | escape }}</button>
<p class="ucro__error" role="alert" hidden></p>
<script type="application/json" data-ucro-prices>
{
"type": {{ utype | json }},{%- if utype == 'variant' -%}"vs": [{%- assign first_v = true -%}{%- for v in product.variants -%}{%- liquid
assign vv = v.options[opt_i] | downcase | strip
assign vt = nil
assign vt_index = 0
for tier in tiers
assign tv = tier.value | downcase | strip
if tv == vv
assign vt = tier
assign vt_index = forloop.index0
break
endif
endfor
-%}{%- if vt == nil -%}{%- continue -%}{%- endif -%}{%- liquid
assign key = ''
for ov in v.options
if forloop.index0 != opt_i
assign key = key | append: ov | append: '|'
endif
endfor
assign v_pct = vt.pct | default: 0
assign v_keep = 100 | minus: v_pct
assign v_total = v.price | times: v_keep | divided_by: 100.0 | round
-%}{%- unless first_v -%},{%- endunless -%}{%- assign first_v = false -%}
{ "id": {{ v.id }}, "k": {{ key | downcase | json }}, "t": {{ vt_index }}, "av": {{ v.available | json }}, "was": {{ v.price | money | json }}, "total": {{ v_total | money | json }} }{%- endfor -%}]{%- else -%}"q": {
{%- for variant in product.variants -%}"{{ variant.id }}": {
"av": {{ variant.available | json }},
"t": [{%- for tier in tiers -%}{%- liquid
assign v_qty = tier.qty | default: 1
assign v_pct = tier.pct | default: 0
assign v_keep = 100 | minus: v_pct
assign v_was = variant.price | times: v_qty
assign v_total = v_was | times: v_keep | divided_by: 100.0 | round
-%}
{ "was": {{ v_was | money | json }}, "total": {{ v_total | money | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}}{%- if per_item -%},"items": [{%- assign first_i = true -%}{%- for variant in product.variants -%}{%- unless variant.available -%}{%- continue -%}{%- endunless -%}{%- unless first_i -%},{%- endunless -%}{%- assign first_i = false -%}
{ "id": {{ variant.id }}, "t": {{ variant.title | json }} }{%- endfor -%}]{%- endif -%}{%- endif -%}}
</script>
</ucro-upsell>
<script src="{{ 'ucro-core.js' | asset_url }}" defer></script>
<script src="{{ 'ucro-offers.js' | asset_url }}" defer></script>{%- elsif request.design_mode -%}<div class="ucro-note" {{ block.shopify_attributes }}>{%- if enabled == false -%}Upsell is switched off in CRO Toolbox.{%- elsif product == blank -%}Upsell only works on product pages.{%- elsif product.available == false -%}Upsell is hidden because this product is sold out.{%- elsif rule and utype == 'variant' and opt_pos == 0 -%}Upsell: rule “{{ rule.name.value | escape }}” offers {{ rule.option_name.value | escape }} tiers, but this product has no “{{ rule.option_name.value | escape }}” option. Only you see this note.{%- else -%}Upsell: no rule matches this product yet. Add one in CRO Toolbox. Only you see this note.{%- endif -%}</div>{%- endif -%}{% schema %}{"name":"Upsell offers","target":"section","stylesheet":"ucro.css","enabled_on":{"templates":["product"]},"settings":[{"type":"paragraph","content":"t:s.n"}]}{% endschema %}
