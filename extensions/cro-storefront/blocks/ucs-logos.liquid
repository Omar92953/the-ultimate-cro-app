{%- liquid
assign s = block.settings
assign items = shop.metaobjects['$app:cro_lists']['main'].logos.value
-%}{%- liquid
assign count = items.size
assign reps = 1
if s.mode == 'marquee' and count > 0
assign reps = 16.0 | divided_by: count | ceil | at_least: 1
endif
assign half = count | times: reps
assign per_logo = 12 | minus: s.speed | times: 0.35
assign duration = half | times: per_logo | at_least: 8
assign two_lines = false
if s.mode == 'marquee' and s.lines == '2' and count > 1
assign two_lines = true
endif
assign shift = count | divided_by: 2 | floor
-%}{%- capture logos -%}{%- for m in items -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: false -%}{%- endfor -%}{%- endcapture -%}{%- capture ghost -%}{%- for m in items -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: true -%}{%- endfor -%}{%- endcapture -%}{%- if two_lines -%}{%- capture logos2 -%}{%- for m in items offset: shift -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: false -%}{%- endfor -%}{%- for m in items limit: shift -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: false -%}{%- endfor -%}{%- endcapture -%}{%- capture ghost2 -%}{%- for m in items offset: shift -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: true -%}{%- endfor -%}{%- for m in items limit: shift -%}{%- render 'ucs-logo-item', m: m, height: s.logo_height, ghost: true -%}{%- endfor -%}{%- endcapture -%}{%- endif -%}<div
class="ucs ucs-logos ucs-logos--{{ s.mode }}{% if s.grayscale %} ucs-logos--gray{% endif %}{% if s.fade_edges %} ucs-logos--fade{% endif %}{% if s.pause_hover %} ucs-logos--pause{% endif %}{% if s.direction == 'right' %} ucs-logos--right{% endif %}{% if s.devices == 'mobile' %} ucs-hide-desktop{% elsif s.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
style="--ucs-pt: {{ s.padding_top }}px; --ucs-pb: {{ s.padding_bottom }}px; --ucs-h: {{ s.heading_size }}px; --ucs-logo-h: {{ s.logo_height }}px; --ucs-logo-gap: {{ s.gap }}px; --ucs-logo-op: {{ s.opacity | divided_by: 100.0 }}; --ucs-logo-dur: {{ duration }}s; --ucs-logo-cols: {{ s.columns_desktop }}; --ucs-logo-cols-m: {{ s.columns_mobile }};{% if s.bg != blank %} background: {{ s.bg }};{% endif %}"
{{ block.shopify_attributes }}
>
<div class="ucs-wrap{% if s.full_width and s.mode == 'marquee' %} ucs-logos__wide{% endif %}">{%- if s.heading != blank -%}<div class="ucs-head"><h2>{{ s.heading | escape }}</h2></div>{%- endif -%}{%- if count > 0 -%}{%- if s.mode == 'marquee' -%}<div class="ucs-logos__viewport">
<ul class="ucs-logos__track" role="list">{{- logos -}}{%- for n in (2..reps) %}{{ ghost }}{% endfor -%}{%- for n in (1..reps) %}{{ ghost }}{% endfor -%}</ul>
</div>{%- if two_lines -%}<div class="ucs-logos__viewport ucs-logos__viewport--2">
<ul class="ucs-logos__track{% if s.opposite %} ucs-logos__track--rev{% endif %}" role="list">{{- logos2 -}}{%- for n in (2..reps) %}{{ ghost2 }}{% endfor -%}{%- for n in (1..reps) %}{{ ghost2 }}{% endfor -%}</ul>
</div>{%- endif -%}{%- else -%}<ul class="ucs-logos__grid" role="list">{{ logos }}</ul>{%- endif -%}{%- elsif request.design_mode -%}<p class="ucs-note">{{ 'ucs.logos_empty' | t }}</p>{%- endif -%}</div>
</div>
{% schema %}{"name":"Scrolling logos and text","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"paragraph","content":"t:s.4u"},{"type":"text","id":"heading","label":"Heading","default":"Trusted by"},{"type":"range","id":"heading_size","label":"t:s.3l","min":14,"max":48,"step":2,"unit":"px","default":22},{"type":"header","content":"Layout"},{"type":"select","id":"mode","label":"Show logos","default":"marquee","options":[{"value":"marquee","label":"t:s.4v"},{"value":"grid","label":"Grid"}]},{"type":"select","id":"lines","label":"Lines","default":"1","options":[{"value":"1","label":"One line"},{"value":"2","label":"Two lines"}],"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"checkbox","id":"opposite","label":"t:s.4w","default":true,"visible_if":"{{ block.settings.mode == 'marquee' and block.settings.lines == '2' }}"},{"type":"range","id":"speed","label":"Speed","min":1,"max":10,"step":1,"default":5,"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"select","id":"direction","label":"Direction","default":"left","options":[{"value":"left","label":"t:s.4x"},{"value":"right","label":"t:s.4y"}],"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"checkbox","id":"pause_hover","label":"t:s.4z","default":true,"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"checkbox","id":"fade_edges","label":"t:s.50","default":true,"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"checkbox","id":"full_width","label":"Full width","default":true,"visible_if":"{{ block.settings.mode == 'marquee' }}"},{"type":"range","id":"columns_desktop","label":"t:s.51","min":2,"max":8,"step":1,"default":5,"visible_if":"{{ block.settings.mode == 'grid' }}"},{"type":"range","id":"columns_mobile","label":"t:s.52","min":2,"max":4,"step":1,"default":3,"visible_if":"{{ block.settings.mode == 'grid' }}"},{"type":"header","content":"Logos"},{"type":"range","id":"logo_height","label":"Logo height","min":16,"max":120,"step":2,"unit":"px","default":40},{"type":"range","id":"gap","label":"t:s.53","min":16,"max":120,"step":4,"unit":"px","default":56},{"type":"checkbox","id":"grayscale","label":"t:s.54","default":true},{"type":"range","id":"opacity","label":"t:s.55","min":30,"max":100,"step":5,"unit":"%","default":80},{"type":"color","id":"bg","label":"Background","info":"t:s.3g"},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":4,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"t:s.3i","min":0,"max":100,"step":4,"unit":"px","default":32},{"type":"select","id":"devices","label":"Devices","default":"all","options":[{"value":"all","label":"t:s.10"},{"value":"desktop","label":"t:s.11"},{"value":"mobile","label":"Mobile only"}]}]}{% endschema %}
