{%- liquid
assign d = shop.metaobjects['$app:cro_design']['logos'].config.value
if request.design_mode and shop.metaobjects['$app:cro_design']['logos_draft'].config.value
assign d = shop.metaobjects['$app:cro_design']['logos_draft'].config.value
endif
assign mode = d.m | default: 'marquee'
assign speed = d.sp | default: 5
assign logo_h = d.lh | default: 40
assign heading = 'Trusted by'
assign wide = true
assign opposite = true
if d
assign heading = d.h
assign wide = d.fw
assign opposite = d.op
endif
assign items = shop.metaobjects['$app:cro_lists']['main'].logos.value
assign count = items.size
assign reps = 1
if mode == 'marquee' and count > 0
assign reps = 16.0 | divided_by: count | ceil | at_least: 1
endif
assign half = count | times: reps
assign per_logo = 12 | minus: speed | times: 0.35
assign duration = half | times: per_logo | at_least: 8
assign two_lines = false
if mode == 'marquee' and d.ln == 2 and count > 1
assign two_lines = true
endif
assign shift = count | divided_by: 2 | floor
-%}{%- capture logos -%}{%- for m in items -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: false -%}{%- endfor -%}{%- endcapture -%}{%- capture ghost -%}{%- for m in items -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: true -%}{%- endfor -%}{%- endcapture -%}{%- if two_lines -%}{%- capture logos2 -%}{%- for m in items offset: shift -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: false -%}{%- endfor -%}{%- for m in items limit: shift -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: false -%}{%- endfor -%}{%- endcapture -%}{%- capture ghost2 -%}{%- for m in items offset: shift -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: true -%}{%- endfor -%}{%- for m in items limit: shift -%}{%- render 'ucs-logo-item', m: m, height: logo_h, ghost: true -%}{%- endfor -%}{%- endcapture -%}{%- endif -%}<div
class="ucs ucs-logos{% if d %}{{ d.cls }}{% else %} ucs-logos--marquee ucs-logos--gray ucs-logos--fade ucs-logos--pause ucs-logos--blend{% endif %}"
style="{{ d.css | default: '--ucs-pt: 32px; --ucs-pb: 32px; --ucs-h: 22px; --ucs-logo-h: 40px; --ucs-logo-gap: 56px; --ucs-logo-op: 0.8; --ucs-logo-cols: 5; --ucs-logo-cols-m: 3;' }} --ucs-logo-dur: {{ duration }}s;"
{{ block.shopify_attributes }}
>
<div class="ucs-wrap{% if wide and mode == 'marquee' %} ucs-logos__wide{% endif %}">{%- if heading != blank -%}<div class="ucs-head"><h2>{{ heading | escape }}</h2></div>{%- endif -%}{%- if count > 0 -%}{%- if mode == 'marquee' -%}<div class="ucs-logos__viewport">
<ul class="ucs-logos__track" role="list">{{- logos -}}{%- for n in (2..reps) %}{{ ghost }}{% endfor -%}{%- for n in (1..reps) %}{{ ghost }}{% endfor -%}</ul>
</div>{%- if two_lines -%}<div class="ucs-logos__viewport ucs-logos__viewport--2">
<ul class="ucs-logos__track{% if opposite %} ucs-logos__track--rev{% endif %}" role="list">{{- logos2 -}}{%- for n in (2..reps) %}{{ ghost2 }}{% endfor -%}{%- for n in (1..reps) %}{{ ghost2 }}{% endfor -%}</ul>
</div>{%- endif -%}{%- else -%}<ul class="ucs-logos__grid" role="list">{{ logos }}</ul>{%- endif -%}{%- elsif request.design_mode -%}<p class="ucs-note">{{ 'ucs.logos_empty' | t }}</p>{%- endif -%}</div>
</div>
{% schema %}{"name":"Scrolling logos and text","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"paragraph","content":"t:s.1x"}]}{% endschema %}
