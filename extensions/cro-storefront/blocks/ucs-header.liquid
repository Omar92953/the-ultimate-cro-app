<script type="application/json">{"c":{{ c | json }},"m":[{%- for a in menu.links -%}{"t":{{ a.title | json }},"u":{{ a.url | json }},"on":{{ a.active | json }},"i":{% if a.object.featured_image %}{{ a.object.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %},"k":[{%- for b in a.links -%}{"t":{{ b.title | json }},"u":{{ b.url | json }},"i":{% if b.object.featured_image %}{{ b.object.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %},"k":[{%- for d in b.links -%}{"t":{{ d.title | json }},"u":{{ d.url | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}{% unless forloop.last %},{% endunless %}{%- endfor -%}]{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%},"loc":{"cc":{{ localization.country.iso_code | json }},"lc":{{ localization.language.iso_code | json }},"co":[{%- if localization.available_countries.size > 1 -%}{%- for x in localization.available_countries -%}[{{ x.iso_code | json }},{{ x.name | json }},{{ x.currency.iso_code | json }}]{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endif -%}],"la":[{%- if localization.available_languages.size > 1 -%}{%- for x in localization.available_languages -%}[{{ x.iso_code | json }},{{ x.endonym_name | json }}]{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endif -%}]}{%- endif -%}}</script>{%- form 'localization', id: 'ucs-hd-loc' -%}{%- endform -%}</div>
