{%- liquid
assign s = block.settings
assign d = shop.metaobjects['$app:cro_design']['faq'].config.value
if request.design_mode and shop.metaobjects['$app:cro_design']['faq_draft'].config.value
assign d = shop.metaobjects['$app:cro_design']['faq_draft'].config.value
endif
assign heading = 'Frequently asked questions'
assign sub = ''
assign tabs = true
assign search = true
assign one_open = true
assign open_first = false
assign columns = 1
assign contact_text = 'Still have a question?'
assign contact_label = 'Contact us'
assign contact_link = ''
if d
assign heading = d.h
assign sub = d.sub
assign tabs = d.tb
assign search = d.se
assign one_open = d.oo
assign open_first = d.of
assign columns = d.col
assign contact_text = d.ct
assign contact_label = d.cl
assign contact_link = d.cu
endif
if s.heading != blank
assign heading = s.heading
endif
assign only_group = s.group | strip | downcase
assign items = shop.metaobjects['$app:cro_lists']['main'].faq.value
assign sel = ','
assign groups = ''
for m in items
if m.question.value == blank
continue
endif
assign g = m.group.value | strip
if only_group != blank
assign g_lower = g | downcase
if g_lower != only_group
continue
endif
endif
if g != blank
assign groups = groups | append: g | append: '|'
endif
assign sel = sel | append: m.system.handle | append: ','
endfor
assign count = 0
if sel != ','
assign count = 1
endif
assign groups = groups | split: '|' | uniq
assign show_tabs = false
if tabs and only_group == blank and groups.size > 1
assign show_tabs = true
endif
assign exclusive = ''
if one_open
assign exclusive = 'ucs-faq-' | append: block.id
endif
-%}<div
class="ucs ucs-faq{% if d %}{{ d.cls }}{% else %} ucs-faq--lines ucs-faq--plus{% endif %}"
style="{{ d.css | default: '--ucs-pt: 40px; --ucs-pb: 40px; --ucs-h: 30px; --ucs-align: center; --ucs-max: 860px; --ucs-faq-q: 16px; --ucs-faq-radius: 10px; --ucs-accent: #121212; --ucs-on-accent: #ffffff;' }}"
{{ block.shopify_attributes }}
>
<div class="ucs-wrap">{%- if heading != blank or sub != blank -%}<div class="ucs-head">{%- if heading != blank %}<h2>{{ heading | escape }}</h2>{% endif -%}{%- if sub != blank %}<p>{{ sub | escape }}</p>{% endif -%}</div>{%- endif -%}{%- if count > 0 -%}{%- if search or show_tabs -%}<div class="ucs-faq__tools">{%- if search -%}<label class="ucs-faq__search">
<span class="ucs-i ucs-i--search" aria-hidden="true"></span>
<input type="search" placeholder="{{ 'ucs.faq_search' | t | escape }}" aria-label="{{ 'ucs.faq_search' | t | escape }}" autocomplete="off">
</label>{%- endif -%}{%- if show_tabs -%}<div class="ucs-faq__tabs" role="group">
<button type="button" class="ucs-faq__tab" data-group="" aria-pressed="true">{{ 'ucs.faq_all' | t }}</button>{%- for g in groups -%}<button type="button" class="ucs-faq__tab" data-group="{{ g | handleize }}" aria-pressed="false">{{ g | escape }}</button>{%- endfor -%}</div>{%- endif -%}</div>{%- endif -%}<div class="ucs-faq__list ucs-faq__list--{{ columns }}">{%- assign n = 0 -%}{%- for m in items -%}{%- assign key = ',' | append: m.system.handle | append: ',' -%}{%- unless sel contains key %}{% continue %}{% endunless -%}{%- assign n = n | plus: 1 -%}<details class="ucs-faq__item" data-group="{{ m.group.value | strip | handleize }}"{% if exclusive != blank %} name="{{ exclusive }}"{% endif %}{% if open_first and n == 1 %} open{% endif %}>
<summary class="ucs-faq__q"><span>{{ m.question.value | escape }}</span><span class="ucs-faq__icon" aria-hidden="true"></span></summary>
<div class="ucs-faq__a">{{ m.answer.value | escape | newline_to_br }}</div>
</details>{%- endfor -%}<p class="ucs-faq__none" hidden>{{ 'ucs.faq_none' | t }}</p>
</div>{%- if s.schema -%}{%- capture entries -%}{%- for m in items -%}{%- assign key = ',' | append: m.system.handle | append: ',' -%}{%- unless sel contains key %}{% continue %}{% endunless -%},{"@type":"Question","name":{{ m.question.value | json }},"acceptedAnswer":{"@type":"Answer","text":{{ m.answer.value | default: '' | json }}}}{%- endfor -%}{%- endcapture -%}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ entries | strip | remove_first: ',' }}]}</script>{%- endif -%}{%- elsif request.design_mode -%}<p class="ucs-note">{{ 'ucs.faq_empty' | t }}</p>{%- endif -%}{%- if contact_label != blank -%}<div class="ucs-faq__help">{%- if contact_text != blank %}<p>{{ contact_text | escape }}</p>{% endif -%}<a class="ucs-btn" href="{{ contact_link | default: '/pages/contact' | escape }}">{{ contact_label | escape }}</a>
</div>{%- endif -%}</div>
</div>{%- if search or show_tabs or exclusive != blank -%}<script src="{{ 'ucs-faq.js' | asset_url }}" defer></script>{%- endif -%}{% schema %}{"name":"FAQ","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"paragraph","content":"t:s.d"},{"type":"text","id":"group","label":"t:s.e","info":"t:s.f"},{"type":"text","id":"heading","label":"t:s.g","info":"t:s.h"},{"type":"checkbox","id":"schema","label":"t:s.i","default":true,"info":"t:s.j"}]}{% endschema %}
