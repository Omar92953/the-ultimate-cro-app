{%- assign bs = block.settings -%}{%- liquid
assign cfg = shop.metaobjects['$app:cro_settings']['settings']
assign enabled = true
if cfg and cfg.videos_enabled.value == false
assign enabled = false
endif
assign show_here = true
if bs.show_on != 'everywhere'
assign type_match = false
case request.page_type
when 'index'
assign type_match = bs.pt_home
when 'product'
assign type_match = bs.pt_product
when 'collection', 'list-collections'
assign type_match = bs.pt_collection
when 'cart'
assign type_match = bs.pt_cart
when 'page'
assign type_match = bs.pt_page
when 'blog', 'article'
assign type_match = bs.pt_blog
when 'search'
assign type_match = bs.pt_search
endcase
assign current_handle = ''
case request.page_type
when 'product'
assign current_handle = product.handle
when 'collection'
assign current_handle = collection.handle
when 'page'
assign current_handle = page.handle
when 'blog'
assign current_handle = blog.handle
when 'article'
assign current_handle = article.handle
endcase
assign handle_match = false
if bs.handles != blank and current_handle != blank
assign handle_list = bs.handles | downcase | remove: ' ' | split: ','
if handle_list contains current_handle
assign handle_match = true
endif
endif
assign is_match = false
if type_match or handle_match
assign is_match = true
endif
if bs.show_on == 'only'
assign show_here = is_match
elsif is_match
assign show_here = false
endif
endif
assign slides = shop.metaobjects['$app:cro_carousel']['main'].slides.value
assign radius = 'var(--product-card-corner-radius, var(--media-radius, 12px))'
if bs.corners == 'square'
assign radius = '0px'
elsif bs.corners == 'round'
assign radius = '28px'
endif
-%}{%- if enabled and show_here and slides.size > 0 -%}<ucro-video-carousel
class="ucro ucro-vc{% if bs.devices == 'mobile' %} ucro-hide-desktop{% elsif bs.devices == 'desktop' %} ucro-hide-mobile{% endif %}"
style="--ucro-align: {{ bs.text_align }}; --ucro-pt: {{ bs.padding_top }}px; --ucro-pb: {{ bs.padding_bottom }}px; --ucro-vc-gap: {{ bs.gap }}px; --ucro-vc-desktop: {{ bs.slides_desktop }}; --ucro-vc-mobile: {{ bs.slides_mobile }}; --ucro-vc-ratio: {{ bs.aspect_ratio }}; --ucro-vc-radius: {{ radius }};"
data-autoplay="{{ bs.autoplay }}"
data-error="{{ 'ucro.error' | t | escape }}"
{{ block.shopify_attributes }}
>{%- if bs.heading != blank -%}<h2 class="ucro__heading ucro__heading--{{ bs.heading_size }}">{{ bs.heading | escape }}</h2>{%- endif -%}{%- if bs.subheading != blank -%}<p class="ucro__sub">{{ bs.subheading | escape }}</p>{%- endif -%}{%- assign track_label = 'ucro.carousel' | t -%}{%- if bs.heading != blank -%}{%- assign track_label = bs.heading -%}{%- endif -%}<ul class="ucro-vc__track" role="list" tabindex="0" aria-roledescription="carousel" aria-label="{{ track_label | strip_html | escape }}">{%- for slide in slides -%}{%- liquid
assign video = slide.video.value
assign image = slide.image.value
assign linked = slide.product.value
assign caption = slide.caption.value
assign label = caption | default: linked.title | default: video.alt | default: shop.name
-%}<li class="ucro-vc__slide" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}">
<div class="ucro-vc__card">
<div class="ucro-vc__media"{% if linked == blank %} data-toggle-play{% endif %}>{%- if video != blank -%}{%- liquid
assign pick = nil
for s in video.sources
if s.mime_type != 'video/mp4'
continue
endif
if pick == nil
assign pick = s
elsif pick.height < 480 and s.height > pick.height
assign pick = s
elsif s.height >= 480 and s.height < pick.height
assign pick = s
endif
endfor
-%}<video
class="ucro-vc__video"
muted
loop
playsinline
preload="none"
{% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 720 }}"{% endif %}
aria-label="{{ label | escape }}"
{% if pick %}data-src="{{ pick.url }}"{% endif %}
></video>{%- if linked == blank -%}<span class="ucro-vc__play" aria-hidden="true"></span>{%- endif -%}{%- elsif image != blank -%}{{ image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 750px) 25vw, 70vw', alt: label }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'ucro-placeholder' }}{%- endif -%}</div>{%- if caption != blank -%}<p class="ucro-vc__caption">{{ caption | escape }}</p>{%- endif -%}{%- if linked != blank -%}<a class="ucro-vc__link" href="{{ linked.url }}" aria-label="{{ linked.title | escape }}" tabindex="-1"></a>{%- endif -%}</div>{%- if linked != blank and bs.show_product -%}<div class="ucro-vc__product">
<a class="ucro-vc__title" href="{{ linked.url }}">{{ linked.title | escape }}</a>
<span class="ucro-vc__price" data-ucro-price>{{ linked.price | money }}</span>{%- if bs.show_add -%}{%- if linked.available and linked.has_only_default_variant -%}<button type="button" class="ucro-btn ucro-vc__add" data-variant="{{ linked.first_available_variant.id }}">{{ bs.add_label | escape }}</button>{%- elsif linked.available -%}<a class="ucro-btn ucro-vc__add" href="{{ linked.url }}">{{ 'ucro.choose_options' | t }}</a>{%- else -%}<button type="button" class="ucro-btn ucro-vc__add" disabled>{{ 'ucro.sold_out' | t }}</button>{%- endif -%}{%- endif -%}</div>{%- endif -%}</li>{%- endfor -%}</ul>{%- if bs.show_arrows and slides.size > 1 -%}<div class="ucro-vc__nav">
<button type="button" class="ucro-vc__arrow" data-dir="-1" aria-label="{{ 'ucro.previous' | t }}">
<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<span class="ucro-vc__counter" aria-hidden="true"><span data-current>1</span> / {{ slides.size }}</span>
<button type="button" class="ucro-vc__arrow" data-dir="1" aria-label="{{ 'ucro.next' | t }}">
<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
</div>{%- endif -%}<p class="ucro__error" role="alert" hidden></p>
</ucro-video-carousel>
<script src="{{ 'ucro-core.js' | asset_url }}" defer></script>
<script src="{{ 'ucro-carousel.js' | asset_url }}" defer></script>{%- elsif request.design_mode -%}<div class="ucro-note" {{ block.shopify_attributes }}>{%- if enabled == false -%}Video carousel is switched off in CRO Toolbox.{%- elsif slides.size == 0 or slides == blank -%}Video carousel: add videos in CRO Toolbox → Video carousel. Only you see this note.{%- else -%}Video carousel: hidden on this page by its "Where to show it" settings. Only you see this note.{%- endif -%}</div>{%- endif -%}{% schema %}{"name":"Video carousel","target":"section","stylesheet":"ucro.css","enabled_on":{"templates":["*"],"groups":["*"]},"settings":[{"type":"paragraph","content":"t:s.1l"},{"type":"header","content":"Heading"},{"type":"text","id":"heading","label":"Heading","default":"See it in action"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"select","id":"heading_size","label":"Size","default":"large","options":[{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}]},{"type":"select","id":"text_align","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"header","content":"Videos"},{"type":"checkbox","id":"autoplay","label":"t:s.1m","default":true,"info":"t:s.1n"},{"type":"checkbox","id":"show_product","label":"t:s.1o","default":true},{"type":"checkbox","id":"show_add","label":"t:s.1p","default":true},{"type":"text","id":"add_label","label":"Button text","default":"Add to cart","visible_if":"{{ block.settings.show_add }}"},{"type":"header","content":"Layout"},{"type":"select","id":"aspect_ratio","label":"Shape","default":"9 / 16","options":[{"value":"9 / 16","label":"t:s.1q"},{"value":"3 / 4","label":"t:s.1r"},{"value":"4 / 5","label":"t:s.1s"},{"value":"1 / 1","label":"t:s.1t"}]},{"type":"range","id":"slides_desktop","label":"t:s.1u","min":2,"max":6,"step":1,"default":4},{"type":"select","id":"slides_mobile","label":"t:s.1v","default":"2.2","options":[{"value":"1.2","label":"t:s.1w"},{"value":"2","label":"2"},{"value":"2.2","label":"t:s.1x"}]},{"type":"checkbox","id":"show_arrows","label":"t:s.1y","default":true},{"type":"header","content":"t:s.w"},{"type":"select","id":"corners","label":"Corners","default":"theme","options":[{"value":"theme","label":"t:s.1z"},{"value":"square","label":"Square"},{"value":"round","label":"t:s.20"}]},{"type":"range","id":"gap","label":"t:s.21","min":4,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"padding_top","label":"Space above","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"Space below","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"header","content":"Visibility"},{"type":"select","id":"devices","label":"Show on","default":"all","options":[{"value":"all","label":"t:s.10"},{"value":"desktop","label":"t:s.11"},{"value":"mobile","label":"Mobile only"}]},{"type":"select","id":"show_on","label":"Pages","default":"everywhere","options":[{"value":"everywhere","label":"t:s.23"},{"value":"only","label":"t:s.24"},{"value":"except","label":"t:s.25"}],"info":"t:s.22"},{"type":"checkbox","id":"pt_home","label":"Home page","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_product","label":"t:s.26","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_collection","label":"t:s.27","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_cart","label":"Cart page","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_page","label":"t:s.28","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_blog","label":"t:s.29","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"checkbox","id":"pt_search","label":"t:s.2a","default":false,"visible_if":"{{ block.settings.show_on != 'everywhere' }}"},{"type":"text","id":"handles","label":"t:s.2b","info":"t:s.2c","visible_if":"{{ block.settings.show_on != 'everywhere' }}"}]}{% endschema %}
