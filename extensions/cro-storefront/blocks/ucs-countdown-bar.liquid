{%- assign d = shop.metaobjects['$app:cro_design'] -%}<div class="ucs ucs-cd-host ucs-cdb" data-ucs-cdb data-page="{{ request.page_type }}" data-handle="{{ product.handle | default: collection.handle }}" data-tz="{{ 'now' | date: '%z' }}" hidden {{ block.shopify_attributes }}>
<script type="application/json">{"header":{{ d['countdown_bar'].config.value | json | default: 'null' }},"footer":{{ d['countdown_footer'].config.value | json | default: 'null' }},"home":{{ d['countdown_home'].config.value | json | default: 'null' }},"product":{{ d['countdown_product'].config.value | json | default: 'null' }}}</script>
</div>
<script src="{{ 'ucs-countdown.js' | asset_url }}" defer></script>
{% schema %}{"name":"Countdown","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"paragraph","content":"t:s.30"}]}{% endschema %}
