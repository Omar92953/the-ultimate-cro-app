{%- assign bs = block.settings -%}{%- liquid
assign show_here = true
if bs.pages != 'all'
case request.page_type
when 'index'
assign show_here = false
if bs.pages == 'home'
assign show_here = true
endif
when 'product'
assign show_here = false
if bs.pages == 'product'
assign show_here = true
endif
when 'collection'
assign show_here = false
if bs.pages == 'collection'
assign show_here = true
endif
when 'cart'
assign show_here = false
if bs.pages == 'cart'
assign show_here = true
endif
else
assign show_here = false
endcase
endif
if show_here and bs.handles != blank
assign current = ''
if request.page_type == 'product'
assign current = product.handle
elsif request.page_type == 'collection'
assign current = collection.handle
endif
if current != blank
assign list = bs.handles | downcase | remove: ' ' | split: ','
unless list contains current
assign show_here = false
endunless
endif
endif
-%}{%- if show_here -%}<div
id="ucs-cdb"
class="ucs ucs-cd-host ucs-cdb ucs-cdb--{{ bs.position }}{% if bs.devices == 'mobile' %} ucs-hide-desktop{% elsif bs.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
style="--ucs-cdb-bg: {{ bs.bg }}; --ucs-cdb-fg: {{ bs.fg }}; --ucs-cdb-fs: {{ bs.font_size }}px; --ucs-accent: {{ bs.box_bg }}; --ucs-on-accent: {{ bs.box_fg }};"{%- if bs.dismissible %} data-dismiss{% endif %}
>
<div class="ucs-cdb__inner">{%- if bs.text != blank %}<span class="ucs-cdb__text">{{ bs.text | escape }}</span>{% endif -%}{%- render 'ucs-countdown-timer', s: bs, key: 'bar' -%}<span class="ucs-cd__end" hidden>{{ bs.ended_text | escape }}</span>{%- if bs.button_label != blank -%}<a class="ucs-btn ucs-cdb__btn" href="{{ bs.button_link | default: routes.all_products_collection_url }}">{{ bs.button_label | escape }}</a>{%- endif -%}{%- if bs.dismissible -%}<button type="button" class="ucs-cdb__close" aria-label="{{ 'ucs.close' | t | escape }}"><span class="ucs-i ucs-i--close" aria-hidden="true"></span></button>{%- endif -%}</div>
</div>
