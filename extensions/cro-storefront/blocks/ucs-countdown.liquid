<div
class="ucs ucs-cd-host ucs-cdh ucs-cdh--{{ block.settings.layout }}{% if block.settings.devices == 'mobile' %} ucs-hide-desktop{% elsif block.settings.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
style="--ucs-pt: {{ block.settings.padding_top }}px; --ucs-pb: {{ block.settings.padding_bottom }}px; --ucs-cd-size: {{ block.settings.digit_size }}px; --ucs-cd-radius: {{ block.settings.radius }}px;{% if block.settings.bg != blank %} --ucs-cd-bg: {{ block.settings.bg }};{% endif %}{% if block.settings.fg != blank %} --ucs-cd-fg: {{ block.settings.fg }};{% endif %} --ucs-accent: {{ block.settings.box_bg }}; --ucs-on-accent: {{ block.settings.box_fg }};"
{{ block.shopify_attributes }}
>
<div class="ucs-wrap ucs-cdh__wrap">{%- if block.settings.heading != blank or block.settings.text != blank -%}<div class="ucs-cdh__text">{%- if block.settings.heading != blank %}<h2 class="ucs-cdh__title">{{ block.settings.heading | escape }}</h2>{% endif -%}{%- if block.settings.text != blank %}<p class="ucs-cdh__sub">{{ block.settings.text | escape }}</p>{% endif -%}</div>{%- endif -%}<div class="ucs-cdh__timer">{%- render 'ucs-countdown-timer', s: block.settings, key: block.id -%}<p class="ucs-cd__end" hidden>{{ block.settings.ended_text | escape }}</p>
</div>{%- if block.settings.button_label != blank -%}<a class="ucs-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}</div>
</div>
<script src="{{ 'ucs-countdown.js' | asset_url }}" defer></script>
{% schema %}{"name":"Countdown timer","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"header","content":"Timer"},{"type":"select","id":"mode","label":"t:s.2x","default":"fixed","options":[{"value":"fixed","label":"t:s.2y"},{"value":"evergreen","label":"t:s.2z"},{"value":"daily","label":"t:s.30"}]},{"type":"text","id":"end_date","label":"Ends on","default":"2026-12-31 23:59","info":"t:s.31","visible_if":"{{ block.settings.mode == 'fixed' }}"},{"type":"range","id":"evergreen_hours","label":"t:s.32","min":1,"max":72,"step":1,"unit":"h","default":24,"visible_if":"{{ block.settings.mode == 'evergreen' }}"},{"type":"text","id":"daily_cutoff","label":"t:s.33","default":"17:00","info":"t:s.3i","visible_if":"{{ block.settings.mode == 'daily' }}"},{"type":"select","id":"ended","label":"t:s.34","default":"hide","options":[{"value":"hide","label":"t:s.3j"},{"value":"message","label":"t:s.36"},{"value":"restart","label":"t:s.37"}]},{"type":"text","id":"ended_text","label":"Message","default":"This offer has ended.","visible_if":"{{ block.settings.ended == 'message' }}"},{"type":"header","content":"Text"},{"type":"text","id":"heading","label":"Heading","default":"Hurry — the sale ends soon"},{"type":"text","id":"text","label":"Text","default":"Up to 30% off. Don't miss out."},{"type":"text","id":"button_label","label":"t:s.38","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Look"},{"type":"select","id":"layout","label":"Layout","default":"stack","options":[{"value":"stack","label":"Centred"},{"value":"row","label":"In one row"}]},{"type":"select","id":"style","label":"Numbers","default":"boxes","options":[{"value":"boxes","label":"In boxes"},{"value":"plain","label":"Plain"}]},{"type":"checkbox","id":"labels","label":"t:s.3b","default":true},{"type":"range","id":"digit_size","label":"Number size","min":18,"max":72,"step":2,"unit":"px","default":36},{"type":"color","id":"box_bg","label":"t:s.3c","default":"#121212"},{"type":"color","id":"box_fg","label":"t:s.3d","default":"#ffffff"},{"type":"color","id":"bg","label":"t:s.3k","info":"t:s.3l"},{"type":"color","id":"fg","label":"t:s.3m"},{"type":"range","id":"radius","label":"Box corners","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"t:s.3n","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"select","id":"devices","label":"Devices","default":"all","options":[{"value":"all","label":"t:s.10"},{"value":"desktop","label":"t:s.11"},{"value":"mobile","label":"Mobile only"}]}]}{% endschema %}
