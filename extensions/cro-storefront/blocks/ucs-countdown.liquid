{%- assign bs = block.settings -%}<div
class="ucs ucs-cd-host ucs-cdh ucs-cdh--{{ bs.layout }}{% if bs.devices == 'mobile' %} ucs-hide-desktop{% elsif bs.devices == 'desktop' %} ucs-hide-mobile{% endif %}"
style="--ucs-pt: {{ bs.padding_top }}px; --ucs-pb: {{ bs.padding_bottom }}px; --ucs-cd-size: {{ bs.digit_size }}px; --ucs-cd-radius: {{ bs.radius }}px;{% if bs.bg != blank %} --ucs-cd-bg: {{ bs.bg }};{% endif %}{% if bs.fg != blank %} --ucs-cd-fg: {{ bs.fg }};{% endif %} --ucs-accent: {{ bs.box_bg }}; --ucs-on-accent: {{ bs.box_fg }};"
{{ block.shopify_attributes }}
>
<div class="ucs-wrap ucs-cdh__wrap">{%- if bs.heading != blank or bs.text != blank -%}<div class="ucs-cdh__text">{%- if bs.heading != blank %}<h2 class="ucs-cdh__title">{{ bs.heading | escape }}</h2>{% endif -%}{%- if bs.text != blank %}<p class="ucs-cdh__sub">{{ bs.text | escape }}</p>{% endif -%}</div>{%- endif -%}<div class="ucs-cdh__timer">{%- render 'ucs-countdown-timer', s: bs, key: block.id -%}<p class="ucs-cd__end" hidden>{{ bs.ended_text | escape }}</p>
</div>{%- if bs.button_label != blank -%}<a class="ucs-btn" href="{{ bs.button_link | default: routes.all_products_collection_url }}">{{ bs.button_label | escape }}</a>{%- endif -%}</div>
</div>
<script src="{{ 'ucs-countdown.js' | asset_url }}" defer></script>
{% schema %}{"name":"Countdown timer","target":"section","stylesheet":"ucs-sections.css","settings":[{"type":"header","content":"Timer"},{"type":"select","id":"mode","label":"t:s.2z","default":"fixed","options":[{"value":"fixed","label":"t:s.30"},{"value":"evergreen","label":"t:s.31"},{"value":"daily","label":"t:s.32"}]},{"type":"text","id":"end_date","label":"Ends on","default":"2026-12-31 23:59","info":"t:s.33","visible_if":"{{ block.settings.mode == 'fixed' }}"},{"type":"range","id":"evergreen_hours","label":"t:s.34","min":1,"max":72,"step":1,"unit":"h","default":24,"visible_if":"{{ block.settings.mode == 'evergreen' }}"},{"type":"text","id":"daily_cutoff","label":"t:s.35","default":"17:00","info":"t:s.36","visible_if":"{{ block.settings.mode == 'daily' }}"},{"type":"select","id":"ended","label":"t:s.37","default":"hide","options":[{"value":"hide","label":"t:s.38"},{"value":"message","label":"t:s.39"},{"value":"restart","label":"t:s.3a"}]},{"type":"text","id":"ended_text","label":"Message","default":"This offer has ended.","visible_if":"{{ block.settings.ended == 'message' }}"},{"type":"header","content":"Text"},{"type":"text","id":"heading","label":"Heading","default":"Hurry — the sale ends soon"},{"type":"text","id":"text","label":"Text","default":"Up to 30% off. Don't miss out."},{"type":"text","id":"button_label","label":"t:s.3b","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Look"},{"type":"select","id":"layout","label":"Layout","default":"stack","options":[{"value":"stack","label":"Centred"},{"value":"row","label":"In one row"}]},{"type":"select","id":"style","label":"Numbers","default":"boxes","options":[{"value":"boxes","label":"In boxes"},{"value":"plain","label":"Plain"}]},{"type":"checkbox","id":"labels","label":"t:s.3c","default":true},{"type":"range","id":"digit_size","label":"Number size","min":18,"max":72,"step":2,"unit":"px","default":36},{"type":"color","id":"box_bg","label":"t:s.3d","default":"#121212"},{"type":"color","id":"box_fg","label":"t:s.3e","default":"#ffffff"},{"type":"color","id":"bg","label":"t:s.3f","info":"t:s.3g"},{"type":"color","id":"fg","label":"t:s.3h"},{"type":"range","id":"radius","label":"Box corners","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"header","content":"Spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"t:s.3i","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"select","id":"devices","label":"Devices","default":"all","options":[{"value":"all","label":"t:s.10"},{"value":"desktop","label":"t:s.11"},{"value":"mobile","label":"Mobile only"}]}]}{% endschema %}
