{%- assign c = shop.metaobjects['$app:cro_design']['footer'].config.value -%}{%- if request.design_mode and shop.metaobjects['$app:cro_design']['footer_draft'].config.value -%}{%- assign c = shop.metaobjects['$app:cro_design']['footer_draft'].config.value -%}{%- endif -%}{%- if c -%}{%- if c.hide -%}<style>.shopify-section-group-footer-group:not(:has(.ucs-ft)) { display: none; }</style>{%- endif -%}<footer class="{{ c.cls }}" style="{{ c.css }}" {{ block.shopify_attributes }}>
<div class="ucs-ft__wrap">
<div class="ucs-ft__cols">{%- for col in c.cols -%}<div class="ucs-ft__col ucs-ft__col--{{ col.k }}">{%- if col.t != blank -%}<h2 class="ucs-ft__title">{{ col.t | escape }}</h2>{%- endif -%}{%- case col.k -%}{%- when 'menu' -%}{%- assign ml = linklists[col.m] -%}{%- if ml.links.size > 0 -%}<ul class="ucs-ft__links">{%- for l in ml.links -%}<li><a href="{{ l.url }}">{{ l.title | escape }}</a></li>{%- endfor -%}</ul>{%- elsif request.design_mode -%}<p class="ucs-ft__text">Menu “{{ col.m | escape }}” not found — create it in Online Store → Navigation.</p>{%- endif -%}{%- when 'text' -%}{%- if col.x != blank -%}<p class="ucs-ft__text">{{ col.x | escape | newline_to_br }}</p>{%- endif -%}{%- when 'logo' -%}<a class="ucs-ft__logo" href="{{ routes.root_url }}">{%- if c.logo -%}<img src="{{ c.logo }}{% if c.logo contains '?' %}&{% else %}?{% endif %}width=480" alt="{{ shop.name | escape }}" width="480" height="160" loading="lazy">{%- else -%}<span>{{ shop.name | escape }}</span>{%- endif -%}</a>{%- if col.x != blank -%}<p class="ucs-ft__text">{{ col.x | escape | newline_to_br }}</p>{%- endif -%}{%- when 'social' -%}{%- if col.x != blank -%}<p class="ucs-ft__text">{{ col.x | escape | newline_to_br }}</p>{%- endif -%}<div class="ucs-ft__social">{%- for s in c.so -%}<a href="{{ s.u }}" target="_blank" rel="noopener" aria-label="{{ s.k | capitalize }}"><span class="ucs-i ucs-i--{{ s.k }}" aria-hidden="true"></span></a>{%- endfor -%}</div>{%- when 'newsletter' -%}{%- if col.x != blank -%}<p class="ucs-ft__text">{{ col.x | escape | newline_to_br }}</p>{%- endif -%}{%- form 'customer', id: 'ucs-ft-news', class: 'ucs-ft__news' -%}<input type="hidden" name="contact[tags]" value="newsletter">{%- if form.posted_successfully? -%}<p class="ucs-ft__ok" role="status">{{ c.nl.thanks | escape }}</p>{%- else -%}<div class="ucs-ft__field">
<input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ c.nl.placeholder | escape }}" aria-label="{{ c.nl.placeholder | escape }}">
<button type="submit" class="ucs-btn">{{ c.nl.button | escape }}</button>
</div>{%- if form.errors -%}<div class="ucs-ft__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}{%- endif -%}{%- endform -%}{%- endcase -%}</div>{%- endfor -%}</div>{%- assign year = 'now' | date: '%Y' -%}{%- assign cr = c.cr | replace: '{year}', year | replace: '{shop}', shop.name -%}<div class="ucs-ft__bottom">{%- if cr != blank -%}<p class="ucs-ft__copy">{{ cr | escape }}</p>{%- endif -%}{%- if c.pol and shop.policies.size > 0 -%}<ul class="ucs-ft__policies">{%- for p in shop.policies -%}<li><a href="{{ p.url }}">{{ p.title | escape }}</a></li>{%- endfor -%}</ul>{%- endif -%}{%- if c.pay and shop.enabled_payment_types.size > 0 -%}<ul class="ucs-ft__pay" aria-label="Payment methods">{%- for t in shop.enabled_payment_types -%}<li>{{ t | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}</div>
</div>
</footer>{%- elsif request.design_mode -%}<p style="padding: 24px; text-align: center;">Design your footer in the app: Storefront → Footer.</p>{%- endif -%}{% schema %}{"name":"Footer","target":"section","enabled_on":{"groups":["footer"]},"stylesheet":"ucs-sections.css","settings":[{"type":"paragraph","content":"t:s.p"}]}{% endschema %}
