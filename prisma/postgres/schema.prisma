// Production schema — keep the models identical to prisma/schema.prisma.

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Production (Supabase Postgres): pooled connection for the app, direct one for migrations.
// Local development uses prisma/schema.prisma (SQLite) instead — same models.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// "Notify me when available": a shopper asked to hear when a sold-out variant is back.
model StockAlert {
  id           Int       @id @default(autoincrement())
  shop         String
  productId    String
  variantId    String
  productTitle String
  variantTitle String    @default("")
  email        String
  createdAt    DateTime  @default(now())
  notifiedAt   DateTime?

  @@unique([shop, variantId, email])
  @@index([shop, notifiedAt])
}

/// "Request a return" from the store: waits for the merchant in the app (Returns).
model ReturnRequest {
  id        Int      @id @default(autoincrement())
  shop      String
  orderId   String
  orderName String
  email     String
  items     String
  reason    String
  note      String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  /// The Shopify return (gid) made when the shopper asked, its name, and what the merchant attached.
  returnId    String   @default("")
  returnName  String   @default("")
  labelUrl    String   @default("")
  tracking    String   @default("")
  trackingUrl String   @default("")
  declineNote String   @default("")
  refundedAt  DateTime?
  /// What the shopper chose: "refund", "credit" or "exchange"; the amount we quoted (the items' price), and how credit was given.
  resolution  String   @default("refund")
  quote       Float    @default(0)
  currency    String   @default("")
  creditKind  String   @default("")
  creditCode  String   @default("")
  creditAmount Float   @default(0)
  creditBonus Int      @default(0)
  creditedAt  DateTime?
  /// Exchanges: what the shopper asked for (JSON lines) and the fulfillment holds we placed until the items arrive.
  exchange    String   @default("")
  holds       String   @default("")

  @@index([shop, status])
}

/// "Request a feature" from the app's Home (Growth and up): waits for Omar, who reads it in the database.
model FeatureRequest {
  id        Int      @id @default(autoincrement())
  shop      String
  plan      String
  text      String
  place     String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([status])
}

/// MCP (AI assistants): an app that registered itself (OAuth dynamic client registration).
model McpClient {
  id           String   @id
  name         String
  redirectUris String
  createdAt    DateTime @default(now())
}

/// A started "Connect" waiting for the merchant's OK in the admin, and then the one use code that follows it.
model McpRequest {
  id            String    @id
  clientId      String
  redirectUri   String
  state         String    @default("")
  challenge     String
  shop          String    @default("")
  /// Set when the merchant allowed it: the code the assistant exchanges for tokens (stored hashed).
  codeHash      String    @default("")
  scope         String    @default("read")
  allowPublish  Boolean   @default(false)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([codeHash])
  @@index([shop])
}

/// What a connected assistant (or a personal access token) may do in one shop. Tokens are stored hashed.
model McpGrant {
  id             String    @id
  shop           String
  kind           String
  name           String
  scope          String    @default("read")
  allowPublish   Boolean   @default(false)
  tokenHash      String    @unique
  refreshHash    String    @default("")
  expiresAt      DateTime?
  refreshExpires DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([shop])
  @@index([refreshHash])
}

/// What assistants did, shown in Settings for 90 days. The summary never holds the full text of a section.
model McpAudit {
  id        Int      @id @default(autoincrement())
  shop      String
  grantId   String
  tool      String
  summary   String   @default("")
  result    String
  build     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([grantId, createdAt])
}

/// Where a store's Track page gets its tracking from (docs/research/tracking-returns.md §9). Keys are stored encrypted.
model TrackingConfig {
  shop          String   @id
  source        String   @default("shopify")
  keyCipher     String   @default("")
  keyLast4      String   @default("")
  provider      String   @default("")
  webhookSecret String   @default("")
  /// Links for carriers Shopify has no link for: [{ name, url with {number} }] (lib/tracking.ts cleanCarrierLinks).
  carrierLinks  String   @default("[]")
  updatedAt     DateTime @default(now())
}

/// The last answer for one tracking number, so the shopper's page reads the cache and the provider is asked a few times a day.
model TrackingCache {
  id        Int      @id @default(autoincrement())
  shop      String
  number    String
  carrier   String   @default("")
  via       String
  status    String   @default("info")
  data      String
  createdAt DateTime @default(now())
  checkedAt DateTime @default(now())

  @@unique([shop, number])
  @@index([checkedAt])
}

/// Shipments registered with our own live tracking account, per store and month (Pro includes 500 a month).
model TrackingUsage {
  shop  String
  month String
  count Int    @default(0)

  @@id([shop, month])
}

/// A/B tests for offers (Pro): shoppers who saw version A or B of a test, per day. Orders and revenue are read from the store's orders.
model AbView {
  shop  String
  test  String
  grp   String
  day   String
  count Int    @default(0)

  @@id([shop, test, grp, day])
}

/// Real discount codes the Track page gives (next order discount, and later friend and delay codes): one per order and kind.
model TrackCode {
  id        Int      @id @default(autoincrement())
  shop      String
  orderId   String
  kind      String
  code      String
  percent   Int      @default(0)
  minimum   Float    @default(0)
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@unique([shop, orderId, kind])
  @@index([shop, kind])
}

/// Orders looked up on the Track page, per day (a real count: one for each order that was found). The Analytics "Track & Returns" card.
model TrackStat {
  id     Int    @id @default(autoincrement())
  shop   String
  day    String
  visits Int    @default(0)

  @@unique([shop, day])
}

/// The email of the person behind a review, typed by the merchant only to check it against orders. Never shown on the store.
model ReviewerEmail {
  id        Int      @id @default(autoincrement())
  shop      String
  reviewId  String
  email     String
  createdAt DateTime @default(now())

  @@unique([shop, reviewId])
  @@index([shop, email])
}

/// Loyalty program (Pro), one per store: its settings (lib/loyalty/config.ts) and where the order sync is up to.
model LoyaltyProgram {
  shop      String    @id
  on        Boolean   @default(false)
  config    String    @default("{}")
  /// Orders and customers changed after this were not read yet (lib/loyalty/sync.server.ts).
  syncedAt  DateTime?
  updatedAt DateTime  @default(now())
}

/// A customer in a store's loyalty program. `points` can be used now; `pending` becomes usable after the pending days.
model LoyaltyMember {
  id           Int       @id @default(autoincrement())
  shop         String
  customerId   String
  email        String    @default("")
  firstName    String    @default("")
  locale       String    @default("")
  /// "MM-DD", typed by the shopper.
  birthday     String    @default("")
  points       Int       @default(0)
  pending      Int       @default(0)
  lifetime     Int       @default(0)
  spent        Float     @default(0)
  orders       Int       @default(0)
  tier         String    @default("")
  tierSince    DateTime?
  referralCode String    @default("")
  referredBy   Int?
  emailOptOut  Boolean   @default(false)
  blocked      Boolean   @default(false)
  joinedAt     DateTime  @default(now())
  lastActivity DateTime  @default(now())

  @@unique([shop, customerId])
  @@index([shop, email])
  @@index([shop, referralCode])
}

/// Every change to a member's points. `dedupe` makes a change happen once (an order's points, a signup bonus).
model LoyaltyEvent {
  id          Int       @id @default(autoincrement())
  shop        String
  memberId    Int
  kind        String
  points      Int
  /// pending, available, expired
  status      String    @default("available")
  orderId     String    @default("")
  /// Money of the order this change is about (order: its net total; refund: negative), for spend based tiers.
  amount      Float     @default(0)
  note        String    @default("")
  dedupe      String?
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([shop, dedupe])
  @@index([shop, memberId, createdAt])
  @@index([status, availableAt])
  @@index([shop, orderId])
}

/// A reward a member got for points: a one use discount code for them only, or store credit.
model LoyaltyReward {
  id         Int       @id @default(autoincrement())
  shop       String
  memberId   Int
  rewardId   String
  kind       String
  title      String
  points     Int
  value      Float     @default(0)
  code       String    @default("")
  discountId String    @default("")
  expiresAt  DateTime?
  usedAt     DateTime?
  orderId    String    @default("")
  createdAt  DateTime  @default(now())

  @@index([shop, memberId, createdAt])
  @@index([shop, code])
}
