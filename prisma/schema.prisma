// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// "Notify me when available": a shopper asked to hear when a sold-out variant is back.
model StockAlert {
  id           Int       @id @default(autoincrement())
  shop         String
  productId    String
  variantId    String
  productTitle String
  variantTitle String    @default("")
  email        String
  createdAt    DateTime  @default(now())
  notifiedAt   DateTime?

  @@unique([shop, variantId, email])
  @@index([shop, notifiedAt])
}

/// "Request a return" from the store: waits for the merchant in the app (Returns).
model ReturnRequest {
  id        Int      @id @default(autoincrement())
  shop      String
  orderId   String
  orderName String
  email     String
  items     String
  reason    String
  note      String   @default("")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  /// The Shopify return (gid) made when the shopper asked, its name, and what the merchant attached.
  returnId    String   @default("")
  returnName  String   @default("")
  labelUrl    String   @default("")
  tracking    String   @default("")
  trackingUrl String   @default("")
  declineNote String   @default("")
  refundedAt  DateTime?
  /// What the shopper chose: "refund", "credit" or "exchange"; the amount we quoted (the items' price), and how credit was given.
  resolution  String   @default("refund")
  quote       Float    @default(0)
  currency    String   @default("")
  creditKind  String   @default("")
  creditCode  String   @default("")
  creditAmount Float   @default(0)
  creditBonus Int      @default(0)
  creditedAt  DateTime?
  /// Exchanges: what the shopper asked for (JSON lines) and the fulfillment holds we placed until the items arrive.
  exchange    String   @default("")
  holds       String   @default("")

  @@index([shop, status])
}

/// Old "Request a feature" rows (the feature was removed in Oct 2026; nothing writes here any more).
/// Kept so no migration drops data; shop redact still deletes a shop's rows.
model FeatureRequest {
  id        Int      @id @default(autoincrement())
  shop      String
  plan      String
  text      String
  place     String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([status])
}

/// MCP (AI assistants): an app that registered itself (OAuth dynamic client registration).
model McpClient {
  id           String   @id
  name         String
  redirectUris String
  createdAt    DateTime @default(now())
}

/// A started "Connect" waiting for the merchant's OK in the admin, and then the one use code that follows it.
model McpRequest {
  id            String    @id
  clientId      String
  redirectUri   String
  state         String    @default("")
  challenge     String
  shop          String    @default("")
  /// Set when the merchant allowed it: the code the assistant exchanges for tokens (stored hashed).
  codeHash      String    @default("")
  scope         String    @default("read")
  allowPublish  Boolean   @default(false)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([codeHash])
  @@index([shop])
}

/// What a connected assistant (or a personal access token) may do in one shop. Tokens are stored hashed.
model McpGrant {
  id             String    @id
  shop           String
  kind           String
  name           String
  scope          String    @default("read")
  allowPublish   Boolean   @default(false)
  tokenHash      String    @unique
  refreshHash    String    @default("")
  expiresAt      DateTime?
  refreshExpires DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([shop])
  @@index([refreshHash])
}

/// What assistants did, shown in Settings for 90 days. The summary never holds the full text of a section.
model McpAudit {
  id        Int      @id @default(autoincrement())
  shop      String
  grantId   String
  tool      String
  summary   String   @default("")
  result    String
  build     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([grantId, createdAt])
}

/// Where a store's Track page gets its tracking from (docs/research/tracking-returns.md §9). Keys are stored encrypted.
model TrackingConfig {
  shop          String   @id
  source        String   @default("shopify")
  keyCipher     String   @default("")
  keyLast4      String   @default("")
  provider      String   @default("")
  webhookSecret String   @default("")
  /// Links for carriers Shopify has no link for: [{ name, url with {number} }] (lib/tracking.ts cleanCarrierLinks).
  carrierLinks  String   @default("[]")
  updatedAt     DateTime @default(now())
}

/// The last answer for one tracking number, so the shopper's page reads the cache and the provider is asked a few times a day.
model TrackingCache {
  id        Int      @id @default(autoincrement())
  shop      String
  number    String
  carrier   String   @default("")
  via       String
  status    String   @default("info")
  data      String
  createdAt DateTime @default(now())
  checkedAt DateTime @default(now())

  @@unique([shop, number])
  @@index([checkedAt])
}

/// Shipments registered with our own live tracking account, per store and month (Pro includes 500 a month).
model TrackingUsage {
  shop  String
  month String
  count Int    @default(0)

  @@id([shop, month])
}

/// A/B tests for offers (Pro): shoppers who saw version A or B of a test, per day. Orders and revenue are read from the store's orders.
model AbView {
  shop  String
  test  String
  grp   String
  day   String
  count Int    @default(0)

  @@id([shop, test, grp, day])
}

/// Real discount codes the Track page gives (next order discount, and later friend and delay codes): one per order and kind.
model TrackCode {
  id        Int      @id @default(autoincrement())
  shop      String
  orderId   String
  kind      String
  code      String
  percent   Int      @default(0)
  minimum   Float    @default(0)
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@unique([shop, orderId, kind])
  @@index([shop, kind])
}

/// Orders looked up on the Track page, per day (a real count: one for each order that was found). The Analytics "Track & Returns" card.
model TrackStat {
  id     Int    @id @default(autoincrement())
  shop   String
  day    String
  visits Int    @default(0)

  @@unique([shop, day])
}

/// The email of the person behind a review, typed by the merchant only to check it against orders. Never shown on the store.
model ReviewerEmail {
  id        Int      @id @default(autoincrement())
  shop      String
  reviewId  String
  email     String
  createdAt DateTime @default(now())

  @@unique([shop, reviewId])
  @@index([shop, email])
}

/// Loyalty program (Pro), one per store: its settings (lib/loyalty/config.ts) and where the order sync is up to.
model LoyaltyProgram {
  shop      String    @id
  on        Boolean   @default(false)
  config    String    @default("{}")
  /// Orders and customers changed after this were not read yet (lib/loyalty/sync.server.ts).
  syncedAt  DateTime?
  /// Ids the app keeps for the program: the referral discount, each affiliate's discount (JSON).
  state     String    @default("{}")
  updatedAt DateTime  @default(now())
}

/// A customer in a store's loyalty program. `points` can be used now; `pending` becomes usable after the pending days.
model LoyaltyMember {
  id           Int       @id @default(autoincrement())
  shop         String
  customerId   String
  email        String    @default("")
  firstName    String    @default("")
  locale       String    @default("")
  /// "MM-DD", typed by the shopper.
  birthday     String    @default("")
  points       Int       @default(0)
  pending      Int       @default(0)
  lifetime     Int       @default(0)
  spent        Float     @default(0)
  orders       Int       @default(0)
  tier         String    @default("")
  tierSince    DateTime?
  /// The tier whose customer tag is on the customer in Shopify (the job brings it in line with `tier`).
  tierTagged   String    @default("")
  referralCode String    @default("")
  referredBy   Int?
  /// The referral discount (its number in LoyaltyProgram.state) the member's code was added to; 0 = never.
  codeGen      Int       @default(0)
  /// Subscribed to email marketing in Shopify (reminder emails go only to them).
  emailMarketing Boolean @default(false)
  emailOptOut  Boolean   @default(false)
  blocked      Boolean   @default(false)
  joinedAt     DateTime  @default(now())
  lastActivity DateTime  @default(now())
  /// Set by Prisma on every change; the customer metafield $app:loyalty is written again when it is newer than `pushedAt`.
  changedAt    DateTime? @updatedAt
  pushedAt     DateTime?

  @@unique([shop, customerId])
  @@index([shop, email])
  @@index([shop, referralCode])
}

/// Every change to a member's points. `dedupe` makes a change happen once (an order's points, a signup bonus).
model LoyaltyEvent {
  id          Int       @id @default(autoincrement())
  shop        String
  memberId    Int
  kind        String
  points      Int
  /// pending, available, expired
  status      String    @default("available")
  orderId     String    @default("")
  /// Money of the order this change is about (order: its net total; refund: negative), for spend based tiers.
  amount      Float     @default(0)
  /// Order points: the VIP tier and campaign multiplier they were earned with (kept, so refunds use the same).
  multiplier  Float     @default(1)
  /// Cashback mode: store credit this order earns (refunds negative); given when usable (`issuedAt`).
  credit      Float     @default(0)
  issuedAt    DateTime?
  note        String    @default("")
  dedupe      String?
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([shop, dedupe])
  @@index([shop, memberId, createdAt])
  @@index([status, availableAt])
  @@index([shop, orderId])
}

/// A reward a member got for points: a one use discount code for them only, or store credit.
model LoyaltyReward {
  id         Int       @id @default(autoincrement())
  shop       String
  memberId   Int
  rewardId   String
  kind       String
  title      String
  points     Int
  value      Float     @default(0)
  code       String    @default("")
  discountId String    @default("")
  expiresAt  DateTime?
  usedAt     DateTime?
  orderId    String    @default("")
  createdAt  DateTime  @default(now())

  @@index([shop, memberId, createdAt])
  @@index([shop, code])
}

/// A referral (a friend's first order with a member's code) or an affiliate sale (an order with a creator's code).
model LoyaltyReferral {
  id               Int       @id @default(autoincrement())
  shop             String
  kind             String
  /// The member who referred (referrals); null for affiliates.
  referrerId       Int?
  affiliateId      String    @default("")
  friendCustomerId String    @default("")
  orderId          String
  orderName        String    @default("")
  amount           Float     @default(0)
  /// rewarded, refused (with the reason), reversed
  status           String
  reason           String    @default("")
  createdAt        DateTime  @default(now())

  @@unique([shop, kind, orderId])
  @@index([shop, referrerId])
  @@index([shop, affiliateId])
}

/// One loyalty email: queued by an event, then sent, skipped (with the reason) or failed. Kept 90 days.
model LoyaltyEmail {
  id         Int       @id @default(autoincrement())
  shop       String
  memberId   Int?
  /// The address it went to (kept for the log; deleted with the member).
  to         String    @default("")
  kind       String
  /// queued, sent, skipped, failed, bounced
  status     String    @default("queued")
  reason     String    @default("")
  /// The words that fill the email ({points}, {code}...), JSON.
  data       String    @default("{}")
  dedupe     String?
  providerId String    @default("")
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@unique([shop, dedupe])
  @@index([shop, status])
  @@index([shop, memberId])
  @@index([shop, createdAt])
}

/// A connected service for the loyalty program (Klaviyo, Omnisend, Judge.me, Shopify Flow): its key (encrypted), on or off.
model LoyaltyIntegration {
  id        Int      @id @default(autoincrement())
  shop      String
  kind      String
  /// The API key, encrypted (lib/tracking/secret.server.ts); "" for Shopify Flow.
  key       String   @default("")
  last4     String   @default("")
  on        Boolean  @default(true)
  /// Where it got to (Judge.me: the last review read), JSON.
  state     String   @default("{}")
  error     String   @default("")
  updatedAt DateTime @default(now())

  @@unique([shop, kind])
}

/// A loyalty event for a connected service (points earned, reward redeemed...): queued, then sent or failed.
model LoyaltyOutbox {
  id        Int       @id @default(autoincrement())
  shop      String
  memberId  Int
  target    String
  kind      String
  data      String    @default("{}")
  dedupe    String?
  status    String    @default("queued")
  reason    String    @default("")
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([shop, dedupe])
  @@index([shop, status])
  @@index([shop, memberId])
}
